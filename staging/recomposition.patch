-  max-inline-size: min(100%, var(--measure-prose-wide));
-}
-
-/* Uppercase micro-labels are not prose and keep their own width. `.hero-note`
-   is not in this list: on the purchase pages it is a full sentence. */
-main :is(.acw-section-label, .eyebrow, .acw-blog-meta) {
-  max-inline-size: none;
-}
-
-/* 5. TARGET SIZE ------------------------------------------------------------
-   Standalone links — breadcrumbs, jump lists, anchor panels, footer
-   navigation, tag and chip rows — are not "inline in a sentence", so WCAG
-   2.2 target size applies to them. Padding rather than height keeps the
-   existing rhythm while making the target real.
-
-   The :not() list matters: without it this rule also matched the real
-   buttons inside those containers — the "Continue reading" action in the
-   guide navigation cards, for one — and pulled their 48px floor down to 24,
-   which is the opposite of the point. A floor for bare links only. */
-:is(
-  .acw-guide-breadcrumb,
-  .acw-guide-jump-links,
-  .acw-post-jump-links,
-  .acw-guide-anchor-panel,
-  .acw-principle-navigation-card,
-  .site-footer-inner,
-  .footer-main,
-  .footer-base,
-  .acw-footer-nav,
-  .disclaimer-links,
-  .checkout-links,
-  .nav__links,
-  .nav__subnav
-) a:not(.acw-btn):not(.button):not(.nav__cta):not(.nav-cta),
-a.acw-post-back-link,
-a.acw-guide-back-link {
-  display: inline-flex;
-  min-height: var(--tap-min);
-  align-items: center;
-}
-
-input[type="checkbox"],
-input[type="radio"] {
-  inline-size: var(--tap-min);
-  block-size: var(--tap-min);
-}
-
-/* 6. VIEWPORT-HEIGHT SAFETY -------------------------------------------------
-   Opening sections used fixed pixel or `100vh` minimums, which on a short
-   laptop or a phone in landscape pushed the promise and the primary action
-   off the first screen. The minimum now only applies when there is height to
-   spend, and uses the small-viewport unit so mobile browser chrome cannot
-   make the section taller than the screen. */
-.acw-hero,
-.acw-home-hero,
-.acw-page-hero,
-.acw-library-hero,
-.acw-blog-hero,
-.acw-contact-page,
-.acw-links-page {
-  min-height: 0;
-}
-
-@media (min-height: 720px) and (min-width: 761px) {
-  .acw-hero,
-  .acw-home-hero {
-    min-height: min(38rem, 78svh);
-  }
-}
-
-/* 7. NO SIDEWAYS SCROLL -----------------------------------------------------
-   `overflow-x: hidden` on html/body hides overflow rather than preventing it.
-   These are the containment rules that stop it happening. */
-img,
-svg,
-video,
-canvas,
-iframe,
-table {
-  max-inline-size: 100%;
-}
-
-pre,
-code {
-  overflow-wrap: anywhere;
-}
-
-.acw-container,
-.container,
-.shell {
-  min-inline-size: 0;
-}
-
-/* 8. DISPLAY COLUMNS AS SIZE CONTAINERS -------------------------------------
-   Every heading ramp in this stylesheet is now written
-   `min(clamp(min, rem + vw, max), Ncqi)`. The clamp is the designed ramp; the
-   container term is a ceiling that says "never so large that this column
-   cannot hold a sensible number of characters". 13cqi on an h1 leaves roughly
-   thirteen characters a line, 12cqi on an h2 about fourteen, 11cqi on an h3
-   about fifteen.
-
-   Without a size container `cqi` resolves against the viewport, where the
-   ceiling is loose enough never to bind on a full-width heading. Declaring
-   the wrappers below as containers is what makes it bind where it matters —
-   a heading inside a 210px card column on a 320px screen. */
-.acw-page-hero-inner,
-.acw-guide-hero-content,
-.acw-post-hero-content,
-.acw-blog-hero-copy,
-.acw-guide-cta-copy,
-.acw-post-cta-copy,
-.acw-guide-next-card,
-.acw-guide-content,
-.acw-post-content,
-.acw-guide-learning-summary,
-.acw-library-latest-copy,
-.acw-library-roadmap,
-.acw-principle-navigation-card,
-.acw-blog-index-card,
-.acw-link-card,
-.aw-links__hero,
-.aw-links__card-content,
-.aw-links__thread-copy,
-.acw-404-panel,
-.acw-offer-card,
-.acw-choice-panel,
-.acw-comparison-card,
-.acw-inclusion-card,
-.acw-connected-stage,
-.acw-process-step,
-.acw-blueprint-card,
-.acw-package-recognition-card,
-.acw-package-process-step,
-.acw-package-inclusion-card,
-.acw-pc-question-card,
-.acw-pc-blueprint-card,
-.acw-pc-service-grid > *,
-.acw-library-resource-card {
-  container-type: inline-size;
-}
-
-/* The page column itself, so a full-width hero heading is measured against
-   the column rather than against the window. */
-.acw-page-hero-inner,
-.acw-reading-width {
-  container-type: inline-size;
-}
-
-/* The legal and policy hero is a layout column, not a line of prose: the
-   measure belongs on the paragraph inside it, not on the wrapper. */
-.acw-page-hero-inner {
-  max-width: min(100%, 56rem);
-}
-
-/* 9. VERY NARROW VIEWPORTS ---------------------------------------------------
-   200% browser zoom on a 390px phone leaves a 195px CSS viewport. The header
-   logo and the footer logo were the two fixed-width elements that pushed the
-   page sideways there. */
-.nav__logo,
-.footer-alternate-logo,
-.footer-logo {
-  max-inline-size: 100%;
-  height: auto;
-}
-
-@media (max-width: 26rem) {
-  .nav__logo {
-    inline-size: min(154px, 46vw);
-  }
-
-  .nav__toggle {
-    flex: 0 0 var(--tap-comfortable);
-    inline-size: var(--tap-comfortable);
-    block-size: var(--tap-comfortable);
-  }
-}
-
-/* A heading is balanced, never prettified: `pretty` optimises the last line of
-   a paragraph, which on a two-line heading is the wrong trade. */
-:is(h1, h2, h3, h4, h5, h6) {
-  text-wrap: balance;
-}
-
-/* Long links and addresses break rather than push the page sideways. */
-main :is(p, li, dd) a,
-.direct-email a,
-.acw-contact-email {
-  overflow-wrap: anywhere;
-}
-
-/* 10. LINKS IN PROSE --------------------------------------------------------
-   WCAG 1.4.1: a link inside a block of text must be distinguishable without
-   relying on colour. On the document pages these carried colour alone. */
-:is(.acw-reading-width, .acw-guide-body, .acw-post-body, .acw-guide-content,
-    .acw-post-content, .legal-content) :is(p, li, dd) a {
-  text-decoration: underline;
-  text-decoration-thickness: from-font;
-  text-underline-offset: 0.18em;
-}
-
-:is(.acw-reading-width, .acw-guide-body, .acw-post-body, .acw-guide-content,
-    .acw-post-content, .legal-content) :is(p, li, dd) a:hover {
-  text-decoration-thickness: 2px;
-}
-
-/* A horizontally scrollable region needs to be reachable by keyboard, and a
-   focusable region needs a visible focus ring. */
-.comparison-table:focus-visible {
-  outline: 3px solid #bd6e4f;
-  outline-offset: 4px;
-}
-
-/* 11. THE LAST OF THE SIDEWAYS SCROLL ---------------------------------------
-   Everything below is only reachable at a CSS viewport under about 200px —
-   200% browser zoom on a 390px phone. WCAG 1.4.10 asks for 320px, which this
-   site already meets with nothing to spare; these make the extreme case
-   behave too. */
-
-/* Two logos and a divider on one flex line cannot fit 195px. */
-.footer-brand-link {
-  flex-wrap: wrap;
-  row-gap: var(--space-8);
-}
-
-@media (max-width: 26rem) {
-  .footer-brand-divider {
-    display: none;
-  }
-}
-
-/* A long unbroken token in a policy document — an address, a reference — must
-   break rather than widen the column. */
-:is(.acw-reading-width, .legal-content, .acw-guide-body, .acw-post-body)
-  :is(p, li, dd, strong, em, code, td) {
-  overflow-wrap: break-word;
-}
-
-/* Form controls default to a content-based minimum width that ignores the
-   grid track they are in. */
-input,
-select,
-textarea,
-fieldset,
-legend,
-label {
-  min-inline-size: 0;
-  max-inline-size: 100%;
-}
-
-fieldset {
-  margin-inline: 0;
-  padding-inline: 0;
-  border: 0;
-}
-
-/* 12. PRIMARY TOUCH TARGETS --------------------------------------------------
-   WCAG 2.2 AA asks for 24 x 24 and the site meets that everywhere. This raises
-   the controls a thumb actually goes for to 44 x 44 — the size Apple and
-   Google both publish. Only controls already within six pixels of it are
-   moved, so nothing is redrawn: the round card link goes 42 to 44, the filter
-   chips 42 to 44, and the library disclosure 38 to 44 inside a header that
-   is already 78px tall. The .acw-btn family needed nothing — its own rules
-   already set 46 and 48px; it was reading 43 only because of the target-size
-   regression fixed in section 5 above.
-
-   The standalone arrow links (.text-link, .acw-library-card-link) sit at
-   24-25px. They pass AA, and reaching 44 would mean either visible padding
-   that changes the card rhythm or an invisible hit area that can overlap a
-   neighbouring control — a judgement call, so they are left alone and
-   reported instead. */
-.catalogue-refresh .circle-link {
-  width: var(--tap-comfortable);
-  height: var(--tap-comfortable);
-}
-
-.catalogue-refresh .filter-chips button {
-  min-height: var(--tap-comfortable);
-}
-
-.nav__links summary,
-.nav__library summary {
-  display: flex;
-  min-height: var(--tap-comfortable);
-  align-items: center;
-}
-
-
-/* =========================================================
-   13. THE TYPE SCALE — ONE SYSTEM, EVERY ROUTE
-   -------------------------------------------------------
-   Before this block the site carried 238 separate heading
-   font-size declarations. An h2 could be 28px on one page
-   and 86px two sections later, and nothing said which was
-   correct. They have all been removed. What is left is
-   four levels, two modifiers, and nothing else.
-
-   Every step is clamp(min, rem + vw, max): the rem term is
-   what keeps the ramp growing under browser zoom, where a
-   preferred size in vw alone would not. Each is also capped
-   in container units, so a heading in a narrow card column
-   can never be set larger than that column can hold.
-   ========================================================= */
-
-:root {
-  /* Display — the opening line of a page, and nothing else. */
-  --step-display: clamp(2.6rem, 3.6vw + 1.55rem, 4.75rem);
-
-  /* h1 — page title.        38 → 62px */
-  --step-1: clamp(2.35rem, 2.7vw + 1.55rem, 3.9rem);
-  /* h2 — section title.     30 → 46px */
-  --step-2: clamp(1.85rem, 1.7vw + 1.4rem, 2.85rem);
-  /* h3 — card and sub-head. 21 → 27px */
-  --step-3: clamp(1.24rem, 0.45vw + 1.13rem, 1.55rem);
-  /* h4 — the smallest heading, and dense card titles. */
-  --step-4: clamp(1.06rem, 0.22vw + 1.01rem, 1.2rem);
-
-  /* Body roles. */
-  --step-lead: clamp(1.08rem, 0.34vw + 1rem, 1.25rem);
-  --step-body: 1rem;
-  --step-small: 0.95rem;
-  --step-label: 0.7rem;
-
-  /* Leading tightens as type grows; tracking closes with it. */
-  --leading-display: 1.02;
-  --leading-1: 1.06;
-  --leading-2: 1.12;
-  --leading-3: 1.28;
-  --leading-4: 1.35;
-  --leading-body: 1.66;
-  --leading-lead: 1.6;
-
-  --tracking-display: -0.022em;
-  --tracking-1: -0.018em;
-  --tracking-2: -0.014em;
-  --tracking-3: -0.008em;
-  --tracking-4: -0.004em;
-}
-
-h1,
-h2,
-h3,
-h4,
-h5,
-h6 {
-  color: var(--ink-text);
-  font-family: var(--font-heading);
-  font-weight: 400;
-  font-synthesis-weight: none;
-  text-wrap: balance;
-  overflow-wrap: break-word;
-}
-
-h1 {
-  font-size: min(var(--step-1), 12cqi);
-  line-height: var(--leading-1);
-  letter-spacing: var(--tracking-1);
-}
-
-h2 {
-  font-size: min(var(--step-2), 9cqi);
-  line-height: var(--leading-2);
-  letter-spacing: var(--tracking-2);
-}
-
-h3 {
-  font-size: min(var(--step-3), 8.2cqi);
-  font-weight: 500;
-  line-height: var(--leading-3);
-  letter-spacing: var(--tracking-3);
-}
-
-h4,
-h5,
-h6 {
-  font-size: var(--step-4);
-  font-weight: 600;
-  line-height: var(--leading-4);
-  letter-spacing: var(--tracking-4);
-}
-
-/* The two sanctioned modifiers.
-
-   `.t-display` is for the first line of a page that is doing the work of a
-   cover — the home page, and nowhere else by default. `.t-compact` is for a
-   heading inside a dense card, where the h3 step would crowd its own copy.
-   Anything that needs a third exception needs a reason first. */
-.t-display {
-  font-size: min(var(--step-display), 11cqi);
-  line-height: var(--leading-display);
-  letter-spacing: var(--tracking-display);
-}
-
-.t-compact {
-  font-size: var(--step-4);
-  font-weight: 600;
-  line-height: var(--leading-4);
-  letter-spacing: var(--tracking-4);
-}
-
-/* Body roles. */
-body {
-  font-size: var(--step-body);
-  line-height: var(--leading-body);
-}
-
-.hero-lead,
-.acw-page-intro,
-.acw-section-intro,
-.acw-hero-text {
-  font-size: var(--step-lead);
-  line-height: var(--leading-lead);
-}
-
-/* The uppercase label above a heading. Small, spaced, and never a heading
-   itself — it is a signpost, so it is set in the body face. */
-.eyebrow,
-.acw-section-label,
-.acw-eyebrow,
-.footer-label {
-  font-family: var(--font-body);
-  font-size: var(--step-label);
-  font-weight: 700;
-  letter-spacing: 0.14em;
-  line-height: 1.4;
-  text-transform: uppercase;
-}
-
-/* Newsreader is a text serif: at display sizes it wants a little more weight
-   than a display serif would, and none of the extra tracking Instrument
-   Serif needed. Deep surfaces get the light-on-dark optical correction. */
-.section-forest h1,
-.section-forest h2,
-.section-forest h3,
-.closing-callout h2,
-.lens-card-dark h2,
-.lens-card-dark h3,
-.acw-surface-ink h1,
-.acw-surface-ink h2,
-.acw-surface-ink h3 {
-  font-weight: 380;
-}
-
-/* The legal pages set the studio email address in <strong> inside a reading
-   column. At 200% zoom on a phone the CSS viewport is under 200px and a
-   27-character address is wider than the column, pushing the page sideways.
-   `anywhere` only breaks a word that cannot otherwise fit, so at every real
-   width the address still sets on one line. */
-.acw-reading-width strong,
-.acw-reading-width code {
-  overflow-wrap: anywhere;
-}
-
-/* =========================================================
-   14. 200% ZOOM ON A PHONE — THE LAST 195px
-   Under about 240 CSS pixels a padded card and a long word are the two
-   remaining ways to push the page sideways. Both are relaxed only here,
-   far below any real device width.
-   ========================================================= */
-@media (max-width: 15rem) {
-  .acw-guide-process-diagram {
-    padding: var(--space-16);
-  }
-
-  .acw-guide-process-diagram li {
-    min-height: 0;
-    padding: var(--space-16);
-  }
-
-  .catalogue-refresh h1,
-  .catalogue-refresh h2,
-  .catalogue-refresh h3 {
-    /* `break-word` lets a long word wrap but still reports the whole word as
-       the element's min-content width, which is what sizes the grid track it
-       sits in. `anywhere` reports the broken width, so the track fits. */
-    overflow-wrap: anywhere;
-  }
-}
-
-/* Fenced code in a guide scrolls inside its own box rather than widening the
-   page. */
-.acw-guide-content pre {
-  overflow-x: auto;
-}
-
-@media (max-width: 15rem) {
-  .acw-guide-process-diagram li strong,
-  .acw-guide-process-diagram li span {
-    overflow-wrap: anywhere;
-  }
-
-  /* A fenced block still scrolls inside its own box at every real width; at
-     200% zoom on a phone it wraps instead, because a horizontal scroller
-     narrower than a thumb is not usable. */
-  .acw-guide-content pre,
-  .acw-guide-content pre code {
-    white-space: pre-wrap;
-    overflow-wrap: anywhere;
-  }
-}
