-.acw-blog-clarity-cta-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; padding: clamp(2.25rem, 5vw, 4.5rem); background: radial-gradient(circle at 100% 0, rgba(215,221,216,.26), transparent 35%), rgba(255,255,255,.84); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow-sm); }
-.acw-blog-clarity-cta h2 { max-width: var(--measure-heading); margin-bottom: 1rem; }
-.acw-blog-clarity-cta div:first-child > p:last-child { max-width: 53ch; margin: 0; color: var(--muted); }
-.acw-blog-clarity-cta-actions { display: flex; gap: 1rem; align-items: flex-start; flex-direction: column; }
-.acw-blog-clarity-cta-actions .acw-btn { width: fit-content; }
