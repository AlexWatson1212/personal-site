-/* =========================================================
-   RESPONSIVE SYSTEM — MEASURE, SCALE, WRAPPING, TARGETS
-   -------------------------------------------------------
-   One shared layer for both stylesheet generations: the
-   acw- pages served from main.css and the refreshed pages
-   that additionally load catalogue-refresh.css.
-
-   The measures are stated in characters because that is the
-   unit the reader experiences. They are floors as much as
-   ceilings: a display column narrow enough to strand single
-   words is as much a defect as a line of body copy running
-   past eighty characters.
-   ========================================================= */
-
-/* 1. MEASURES ---------------------------------------------------------------
-   `ch` is the width of "0", which is not the width of an average character.
-   Measured across this site's rendered text: Instrument Serif sets about
-   0.92 characters per ch at heading sizes, Inter about 1.33 at body sizes.
-   The prose tokens are therefore smaller than the character count they aim
-   at — 49ch sets about 65 characters and 55ch about 73, inside the 55–70
-   band and never past 80.
-
-   Display measures widen as the viewport narrows: the type ramp shrinks more
-   slowly than the container does, so the same ch count buys fewer words. */
-:root {
-  --measure-display: 20ch;        /* h1 */
-  --measure-heading: 22ch;        /* h2 */
-  --measure-subhead: 26ch;        /* h3–h6, card titles */
-  --measure-prose-tight: 40ch;    /* captions, notes, card copy ≈ 53 chars */
-  --measure-prose: 49ch;          /* default body measure       ≈ 65 chars */
-  --measure-prose-wide: 55ch;     /* long-form ceiling          ≈ 73 chars */
-  --tap-min: 24px;                /* WCAG 2.2 AA target size */
-  --tap-comfortable: 44px;
-  --text-min: 0.95rem;            /* nothing that reads as prose sets smaller */
-}
-
-@media (max-width: 980px) {
-  :root {
-    --measure-display: 22ch;
-    --measure-heading: 24ch;
-    --measure-subhead: 28ch;
-  }
-}
-
-@media (max-width: 560px) {
-  :root {
-    --measure-display: 26ch;
-    --measure-heading: 28ch;
-    --measure-subhead: 32ch;
-  }
-}
-
-/* 3. WRAPPING ---------------------------------------------------------------
-   `balance` for headings — Chromium applies it to the first six lines, which
-   is the whole useful range for a heading and is why the measures above
-   matter more than the property does. `pretty` for anything that reads as a
-   sentence, which pushes the last-line orphan back up into the paragraph. */
-h1,
-h2,
-h3,
-h4,
-h5,
-h6,
-figcaption,
-caption,
-.acw-page-intro,
-.acw-section-intro {
-  text-wrap: balance;
-}
-
-p,
-li,
-dd,
-dt,
-blockquote,
-summary,
-td,
-th,
-figcaption {
-  text-wrap: pretty;
-}
-
-/* Long words must break rather than push the page sideways. */
-h1,
-h2,
-h3,
-h4,
-h5,
-h6 {
-  overflow-wrap: break-word;
-}
-
-/* 4. PROSE MEASURE ----------------------------------------------------------
-   A default, not an override: any component that states its own measure still
-   wins on specificity. This only catches copy that had no measure at all,
-   which is where every over-80-character line came from. */
-main :is(p, li, dd) {
-  max-inline-size: min(100%, var(--measure-prose));
-}
-
-/* Long-form documents — guides, journal posts, legal pages — read on the
-   wider ceiling rather than the default band. */
