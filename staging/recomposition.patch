+layout: default
+title: Practice Clarity Library
+description: Nine short principles and two practical guides for therapists who have to describe their own work — free to read, and the thinking behind the Practice Clarity service.
+permalink: /practice-clarity/
+image: /assets/images/library/library-hero.webp
+---
+
+{% assign principles = site.guides | where: "category", "Practice Clarity" | where: "featured", true | sort: "featured_order" %}
+{% assign practical = site.guides | where: "category", "Practical Guides" %}
+{% assign closing = site.guides | where: "slug", "closing-reflection" | first %}
+
+<section class="band band--sm on-paper">
+  <div class="wrap">
+    <div class="split split--wide-left align-end">
+      <div class="stack stack--loose">
+        <p class="label">Practice Clarity Library</p>
+        <h1 class="measure-2xs">Nine short principles for describing your own work.</h1>
+        <p class="lead">
+          Free to read, in any order. This is the thinking the Practice Clarity
+          service does with you &mdash; written down so you can use it without
+          buying anything.
+        </p>
+      </div>
+      <figure class="portrait portrait--wide">
+        <img src="{{ '/assets/images/library/library-hero.webp' | relative_url }}"
+             alt="Handwritten notes and printed pages on a desk in warm afternoon light"
+             loading="eager" decoding="async" width="1586" height="992">
+      </figure>
+    </div>
+  </div>
+</section>
+
+<section class="band on-sage">
+  <div class="wrap">
+    <div class="spread mb-6">
+      <div class="spread__aside"><p class="label">The pathway</p></div>
+      <div class="spread__body">
+        <h2 class="measure-sm">Understand the practice, express it, then make the next step clear.</h2>
+        <p class="quiet mt-4 measure-2xl">
+          Three stages in the natural order of a good therapist website. Each contains
+          three principles. Start at the beginning, or go straight to the decision in
+          front of you.
+        </p>
+      </div>
+    </div>
+
+    {% for stage in site.data.library.stages %}
+      {% assign from = forloop.index0 | times: 3 %}
+      <div class="stage-head">
+        <p class="label m-0">Stage {{ forloop.index }}</p>
+        <div>
+          <h2>{{ stage.title }}</h2>
+          <p>{{ stage.note }}</p>
+        </div>
+      </div>
+      <div class="principles">
+        {% for principle in principles offset: from limit: 3 %}
+          <a class="principle" href="{{ principle.url | relative_url }}">
+            <span class="principle__n">{{ principle.featured_order | prepend: '0' | slice: -2, 2 }}</span>
+            <span class="principle__name">{{ principle.title }}</span>
+            <span class="principle__note">{{ principle.excerpt | default: principle.description | strip_html | truncate: 130 }}</span>
+            <span class="direction__go">Read <span aria-hidden="true">&rarr;</span></span>
+          </a>
+        {% endfor %}
+      </div>
+    {% endfor %}
+
+    {% if closing %}
+      <p class="mt-6">
+        <a class="tlink" href="{{ closing.url | relative_url }}">{{ closing.title }} <span aria-hidden="true">&rarr;</span></a>
+      </p>
+    {% endif %}
+  </div>
+</section>
+
+<section class="band on-paper">
+  <div class="wrap">
+    <div class="split split--wide-left mb-7">
+      <div>
+        <p class="label">Practical guides</p>
+        <h2 class="measure-xs">Longer pieces, for a specific job.</h2>
+      </div>
+      <p class="quiet" style="align-self:end">
+        Evergreen guidance for the places prospective clients actually find and
+        judge a practice.
+      </p>
+    </div>
+
+    <div class="article-grid">
+      {% for guide in practical %}
+        <article class="article-card">
+          <a class="article-card__link" href="{{ guide.url | relative_url }}">
+            {% if guide.hero_image %}
+              <div class="article-card__media">
+                <img src="{{ guide.hero_image | relative_url }}" alt="" loading="lazy" decoding="async" width="1586" height="992">
+              </div>
+            {% endif %}
+            <p class="article-card__meta"><span>Guide</span>{% if guide.read_time %}<span>{{ guide.read_time }}</span>{% endif %}</p>
+            <h3>{{ guide.title }}</h3>
+            <p>{{ guide.excerpt | default: guide.description | strip_html | truncate: 150 }}</p>
+            <span class="tlink">Read the guide <span aria-hidden="true">&rarr;</span></span>
+          </a>
+        </article>
+      {% endfor %}
+    </div>
+  </div>
+</section>
+
+<section class="band band--sm on-paper-deep">
+  <div class="wrap">
+    <div class="split split--wide-left">
+      <div>
+        <p class="label">Shorter pieces</p>
+        <h2 class="measure-2xs">The Journal.</h2>
+      </div>
+      <div class="stack stack--loose">
+        <p class="quiet">Reflections on therapist websites, private-practice clarity and the decisions that make online trust easier to build.</p>
+        <p><a class="tlink" href="{{ '/blog/' | relative_url }}">Browse the Journal <span aria-hidden="true">&rarr;</span></a></p>
+      </div>
+    </div>
+  </div>
+</section>
+
+<section class="band on-ink">
+  <div class="wrap">
+    <div class="split split--wide-left">
+      <div>
+        <p class="label">A clearer next step</p>
+        <h2 class="measure-xs">You do not need to market more loudly.</h2>
+      </div>
+      <div class="stack stack--loose">
+        <p>
+          If reading it through is enough, that is a good outcome and it costs nothing.
+          If you would rather have it decided with you and written down, that is
+          Practice Clarity &mdash; £500 alongside a website.
+        </p>
+        <div class="actions">
+          <a class="btn" href="{{ '/service/#practice-clarity' | relative_url }}">What it costs<span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
+          <a class="tlink" href="{{ '/work/' | relative_url }}">See the collection <span aria-hidden="true">&rarr;</span></a>
+        </div>
+      </div>
+    </div>
+  </div>
+</section>
