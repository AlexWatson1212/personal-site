-/* =========================================================
-   DOCUMENT AND LIBRARY REFINEMENTS
-   -------------------------------------------------------
-   The pages that still use the acw- system — the legal
-   documents, the Practice Clarity Library, the Journal, the
-   guides, the links page and 404 — inherited the marketing
-   display scale, including `h2 { max-width: 13ch }`. On a
-   clause-numbered legal page that produced 40–69px headings
-   stacked four words deep, which is why those pages read as
-   less finished than the rest of the site.
-
-   This block gives long-form documents a document scale,
-   without touching the marketing pages.
-   ========================================================= */
-
-.acw-reading-width {
-  max-width: var(--measure-prose-wide);
-}
-
-.acw-reading-width h2 {
-  max-width: 34ch;
-  margin-top: 3.25rem;
-
-}
-
-.acw-reading-width h3 {
-  max-width: 38ch;
-  margin-top: 2rem;
-  
-}
-
-.acw-reading-width p,
-.acw-reading-width li {
-  text-wrap: pretty;
-}
-
-.acw-reading-width li {
-  color: inherit;
-}
-
-/* Legal pages are documents, not campaigns: a calmer hero. */
-.acw-page-hero h1 {
-  max-width: var(--measure-display);
-}
-
-.acw-reading-width ~ * h1,
-.acw-page-hero .acw-page-intro {
-  max-width: var(--measure-prose-wide);
-}
-
-/* Body copy in the guides and journal reads better a little wider. */
-.acw-guide-body p,
-.acw-post-body p {
-  text-wrap: pretty;
-}
-
-/* Headings must not push a narrow screen sideways. */
-.acw-container h1,
-.acw-container h2,
-.acw-container h3 {
-  overflow-wrap: break-word;
-}
-
-/* The review marker was 3.5:1 against paper; AA text needs 4.5:1. */
-.legal-flag {
-  color: #7f5039;
-}
-
-.legal-todo {
-  color: #7f5039;
-  border-bottom-color: rgba(127, 80, 57, 0.85);
-}
-
-/* In-page anchors clear the sticky header. */
-.acw-container [id],
-.acw-guide-body [id] {
-  scroll-margin-top: 96px;
-}
-
-/* Shared display measure and floor for the acw- pages, matching the
-   refreshed pages. The previous values (h1 12.5ch / h2 13ch, with a
-   50px floor on a 320px screen) produced two-word lines, very tall
-   heroes and a single-word last line on most headings. */
-h1 { max-width: var(--measure-display); }
-h2 { max-width: var(--measure-heading); }
-
-@media (max-width: 980px) {
-  h1 { max-width: var(--measure-display); }
