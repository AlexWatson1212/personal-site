-/* =========================================================
-   RESPONSIVE REFINEMENT — AUGUST 2026
-   -------------------------------------------------------
-   Three things, all systemic rather than per-screen:
-
-   1. Display type is capped by the width of the column it
-      sits in, so a heading can never be set so large that
-      its column strands single words. The cap is expressed
-      in container units, which is the only unit that knows
-      how wide the column actually is.
-   2. Multi-column blocks reflow intrinsically instead of at
-      hand-placed breakpoints, so no column is ever squeezed
-      below the width its content needs.
-   3. Card heights come from the grid rather than from
-      hand-tuned `min-height` values.
-   ========================================================= */
-
-/* 1. DISPLAY COLUMNS --------------------------------------------------------
-   The cap is a share of the container's inline size. Instrument Serif sets
-   about 1.84 characters per unit of (containerWidth / fontSize), so a cap of
-   14.2cqi holds ~13 characters a line, 12.3cqi holds ~15 and 10.2cqi ~18.
-
-   Where the heading sits inside its own wrapper the wrapper is the container
-   and the cap is stated directly. Where the heading is a direct child of the
-   grid, the grid is the container and the cap is scaled by that column's
-   share of the grid — reset to the full share once the grid has stacked. */
-
-.catalogue-refresh .home-hero-copy,
-.catalogue-refresh .about-hero-grid > div:first-child,
-.catalogue-refresh .contact-copy,
-.catalogue-refresh .page-hero-grid > div:first-child,
-.catalogue-refresh .design-detail-heading > div:first-child,
-.catalogue-refresh .section-heading-row > div:first-child,
-.catalogue-refresh .service-detail-head > div:first-child,
-.catalogue-refresh .lens-card,
-.catalogue-refresh .care-card,
-.catalogue-refresh .offer-card,
-.catalogue-refresh .project-meta,
-.catalogue-refresh .difference-grid article,
-.catalogue-refresh .belief-grid article,
-.catalogue-refresh .adapt-grid article,
-.catalogue-refresh .before-grid article,
-.catalogue-refresh .service-scope-grid > div,
-.catalogue-refresh .form-heading,
-.catalogue-refresh .live-note-inner > div:first-child {
-  container-type: inline-size;
-}
-
-
-
-/* Split grids: the heading is a direct grid child, so the grid is the
-   container and the cap is that track's share of it (~0.55). */
-.catalogue-refresh .split-heading,
-.catalogue-refresh .not-template-grid,
-.catalogue-refresh .process-grid,
-.catalogue-refresh .callout-grid,
-.catalogue-refresh .rationale-grid,
-.catalogue-refresh .revision-grid,
-.catalogue-refresh .care-grid,
-.catalogue-refresh .strength-grid,
-.catalogue-refresh .working-style-grid,
-.catalogue-refresh .choice-guide-grid,
-.catalogue-refresh .service-detail-head,
-.catalogue-refresh .background-grid,
-.catalogue-refresh .before-contact > .shell > div:first-child {
-  container-type: inline-size;
-}
-
-/* 2. INTRINSIC MULTI-COLUMN BLOCKS -----------------------------------------
-   `repeat(auto-fit, minmax(min(100%, <the width this content needs>), 1fr))`
-   drops a column the moment the remaining ones would fall below that width,
-   at any viewport, with no breakpoint to keep in sync. `min(100%, …)` is what
-   stops the track floor from causing overflow at 320px. */
-.catalogue-refresh .quality-row {
-  grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
-}
-
-.catalogue-refresh .difference-grid {
-  grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
-}
-
-.catalogue-refresh .offer-grid {
-  grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
-  align-items: stretch;
-}
-
-.catalogue-refresh .project-grid {
-  /* The collection is designed two-up. `auto-fit` alone cannot express "at
-     most two", and a floor high enough to prevent a third column at 1180
-     also dropped the grid to a single column at 1024 — so the floor keeps
-     the reflow honest below the desktop range, and the desktop range states
-     the two columns it was designed for. */
-  grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
-}
-
-@media (min-width: 62rem) {
