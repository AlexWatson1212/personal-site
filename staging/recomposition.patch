+<!-- _includes/head.html -->
+
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+
+{%- comment -%}
+  One place decides the browser-tab title. Page front matter carries the page
+  name only — never the studio name — so the suffix is never doubled.
+{%- endcomment -%}
+{%- if page.url == '/' -%}
+  {%- assign page_title = site.brand | append: ' · Websites for therapists' -%}
+{%- elsif page.title -%}
+  {%- assign page_title = page.title | append: ' · ' | append: site.brand -%}
+{%- else -%}
+  {%- assign page_title = site.brand -%}
+{%- endif -%}
+<title>{{ page_title }}</title>
+
+<meta
+  name="description"
+  content="{% if page.description %}{{ page.description | strip_html | strip_newlines | escape }}{% else %}{{ site.description | escape }}{% endif %}"
+>
+
+<link rel="canonical" href="{{ page.url | absolute_url }}">
+<meta name="baseurl" content="{{ site.baseurl }}">
+
+{% if page.noindex %}
+<meta name="robots" content="noindex, nofollow">
+{% endif %}
+
+{%- comment -%}
+  Both faces are self-hosted and used above the fold on every route, so both
+  are preloaded. Two files, 106 KB, no third-party request — font-src is 'self'.
+{%- endcomment -%}
+<link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/newsreader-latin-wght-normal.woff2' | relative_url }}" crossorigin>
+<link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/inter-latin-wght-normal.woff2' | relative_url }}" crossorigin>
+
+{%- comment -%}
+  One stylesheet for the whole site. It is written rather than accumulated,
+  so there is nothing to purge and nothing page-specific to split out: the
+  first page pays ~11 KB over the wire and every page after it pays nothing.
+{%- endcomment -%}
+<link rel="stylesheet" href="{{ '/assets/css/studio.min.css' | relative_url }}?v={{ site.time | date: '%s' }}">
+
+<!-- Favicons -->
+<link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/brand/favicon-32x32.png' | relative_url }}">
+<link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/images/brand/favicon-16x16.png' | relative_url }}">
+<link rel="shortcut icon" type="image/png" href="{{ '/assets/images/brand/favicon.png' | relative_url }}">
+<link rel="manifest" href="{{ '/site.webmanifest' | relative_url }}">
+
+<meta name="theme-color" content="#263835">
+<meta name="color-scheme" content="light">
+
+<!-- Open Graph -->
+<meta property="og:type" content="website">
+<meta property="og:title" content="{{ page_title | escape }}">
+<meta property="og:description" content="{% if page.description %}{{ page.description | strip_html | strip_newlines | escape }}{% else %}{{ site.description | escape }}{% endif %}">
+<meta property="og:url" content="{{ page.url | absolute_url }}">
+<meta property="og:site_name" content="{{ site.brand }}">
+<meta property="og:image" content="{{ page.image | default: '/assets/images/service/alexander-watson-counselling-case-study.webp' | absolute_url }}">
+<meta property="og:image:alt" content="Alexander Watson Studio — websites for therapists">
+<meta property="og:image:width" content="1376">
+<meta property="og:image:height" content="864">
+
+<!-- Twitter -->
+<meta name="twitter:card" content="summary_large_image">
+<meta name="twitter:title" content="{{ page_title | escape }}">
+<meta name="twitter:description" content="{% if page.description %}{{ page.description | strip_html | strip_newlines | escape }}{% else %}{{ site.description | escape }}{% endif %}">
+<meta name="twitter:image" content="{{ page.image | default: '/assets/images/service/alexander-watson-counselling-case-study.webp' | absolute_url }}">
+<meta name="twitter:image:alt" content="Alexander Watson Studio — websites for therapists">
