-.acw-blog-hero { padding: clamp(5rem, 9vw, 8.75rem) 0 clamp(4.5rem, 8vw, 7rem); background: radial-gradient(circle at 18% 0, rgba(215,221,216,.22), transparent 36%), var(--surface); }
-.acw-blog-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .58fr); gap: clamp(3rem, 8vw, 8.5rem); align-items: center; }
-.acw-blog-hero-copy { max-width: 660px; }
-.acw-blog-hero h1 { max-width: var(--measure-display); margin-bottom: 1.35rem; }
-.acw-blog-hero-copy > p:not(.acw-section-label) { max-width: 48ch; margin: 0; color: var(--muted); font-size: clamp(1.04rem, 1.3vw, 1.2rem); line-height: 1.72; }
-.acw-blog-hero-copy .acw-library-text-link { margin-top: 1.8rem; }
-.acw-blog-hero-media { width: min(100%, 440px); justify-self: end; margin: 0; }
-.acw-blog-hero-media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
-
-.acw-blog-index { padding: clamp(4.75rem, 8vw, 7.75rem) 0; background: var(--surface-quiet); border-top: 1px solid var(--line); }
-.acw-blog-index-heading { max-width: 660px; margin-bottom: clamp(2.7rem, 5vw, 4.5rem); }
-.acw-blog-index-heading h2 { max-width: var(--measure-heading); margin-bottom: 1rem; }
-.acw-blog-index-heading > p:last-child { max-width: 52ch; color: var(--muted); }
-.acw-blog-index-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
-.acw-blog-index-card { display: flex; min-width: 0; overflow: hidden; flex-direction: column; background: rgba(255,255,255,.86); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow-xs); }
-.acw-blog-index-card-copy { display: flex; min-height: 260px; padding: 1.45rem; flex-direction: column; }
-.acw-blog-index-card h3 { max-width: none; margin-bottom: .7rem; }
-.acw-blog-index-card h3 a { color: var(--text); }
-.acw-blog-index-card-copy > p:not(.acw-blog-meta) { color: var(--muted); font-size: .91rem; line-height: 1.6; }
-.acw-blog-index-card .acw-library-card-link { margin-top: auto; }
-.acw-blog-index-image { display: block; overflow: hidden; }
-.acw-blog-index-image img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .7s ease; }
-.acw-blog-index-card:hover img { transform: scale(1.025); }
