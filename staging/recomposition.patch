+/* ==========================================================================
+   ALEXANDER WATSON STUDIO
+   One stylesheet. Written, not accumulated.
+
+   This file replaces main.css (14,899 lines of forty-three dated override
+   passes), visual-system.css and catalogue-refresh.css. Everything the site
+   renders is defined once, in cascade order, with no !important anywhere.
+
+   01  TOKENS
+   02  RESET AND BASE
+   03  TYPOGRAPHY
+   04  LAYOUT
+   05  MOTION
+   06  ACTIONS
+   07  HEADER
+   08  FOOTER
+   09  DESIGN PLATES (the collection specimens)
+   10  HOME
+   11  COLLECTION
+   12  INFORMATION DESIGN (anatomy, ledger, pathway, timeline)
+   13  PRICES AND SCOPE
+   14  ABOUT
+   15  CONTACT AND FORMS
+   16  LIBRARY, JOURNAL, ARTICLES
+   17  PROSE AND LEGAL
+   18  PURCHASE JOURNEY
+   19  SMALL PAGES
+   ========================================================================== */
+
+/* ==========================================================================
+   01  TOKENS
+   ========================================================================== */
+
+@font-face {
+  font-family: "Newsreader";
+  font-style: normal;
+  font-weight: 200 800;
+  font-display: swap;
+  src: url("/assets/fonts/newsreader-latin-wght-normal.woff2") format("woff2");
+}
+
+@font-face {
+  font-family: "Inter";
+  font-style: normal;
+  font-weight: 100 900;
+  font-display: swap;
+  src: url("/assets/fonts/inter-latin-wght-normal.woff2") format("woff2");
+}
+
+:root {
+  /* ---- Surfaces. Three, as before. Nothing else is a background. ---- */
+  --paper: #f7f4ef;
+  --paper-deep: #f0ece4;
+  --sage: #e4e9e2;
+  --ink: #263835;
+  --ink-deep: #1c2a27;
+
+  /* ---- Content ---- */
+  --text: #1d2622;
+  --text-quiet: #4e5852;    /* 7.0:1 on paper */
+  --text-faint: #5b645e;    /* 5.6:1 on paper, 5.0:1 on sage — labels and captions */
+  --on-ink: #f2efe8;
+  --on-ink-quiet: #b6c2bb;
+
+  /* ---- Line work. Rules do the work that cards and shadows used to. ---- */
+  --line: #d9d3c8;
+  --line-soft: #e6e0d5;
+  --line-strong: #b4ada0;
+  --line-on-ink: rgba(242, 239, 232, 0.22);
+  --line-on-sage: #cbd3c8;
+
+  /* ---- One accent. Used for marks, never for surfaces. ---- */
+  --clay: #8a5238;
+  --clay-quiet: #a97b62;
+
+  /* ---- Type ---- */
+  --serif: "Newsreader", "Iowan Old Style", Georgia, serif;
+  --sans: "Inter", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
+
+  --t-display: clamp(2.75rem, 1.35rem + 5.2vw, 5.5rem);
+  --t-h1: clamp(2.25rem, 1.4rem + 3.3vw, 4.15rem);
+  --t-h2: clamp(1.8rem, 1.32rem + 1.95vw, 2.95rem);
+  --t-h3: clamp(1.3rem, 1.18rem + 0.5vw, 1.6rem);
+  --t-h4: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
+  --t-lead: clamp(1.08rem, 1.02rem + 0.34vw, 1.3rem);
+  --t-body: 1.0625rem;
+  --t-small: 0.9375rem;
+  --t-tiny: 0.875rem;
+  --t-label: 0.6875rem;
+
+  --lh-display: 1.02;
+  --lh-heading: 1.08;
+  --lh-body: 1.62;
+
+  /* ---- Space. A single scale. ---- */
+  --s-1: 0.25rem;
+  --s-2: 0.5rem;
+  --s-3: 0.75rem;
+  --s-4: 1rem;
+  --s-5: 1.5rem;
+  --s-6: 2rem;
+  --s-7: 3rem;
+  --s-8: 4rem;
+  --s-9: 6rem;
+  --s-10: 8rem;
+  --s-11: 10rem;
+
+  --band: clamp(4.25rem, 8.5vw, 8.5rem);
+  --band-lg: clamp(5.5rem, 12vw, 12rem);
+  --band-sm: clamp(3rem, 6vw, 5.5rem);
+
+  /* ---- Measure ---- */
+  --gutter: clamp(1.35rem, 4.2vw, 3.5rem);
+  --wrap: 1180px;
+  --wrap-wide: 1440px;
+  --wrap-text: 34rem;
+  --wrap-mid: 46rem;
+
+  /* ---- Form ---- */
+  --r-xs: 2px;
+  --r-sm: 3px;
+  --r: 5px;
+  --r-lg: 10px;
+  --hairline: 1px;
+
+  /* ---- Motion grammar. Consistency is what makes subtle motion read as
+         expensive. Every entrance in this site travels the same distance,
+         over the same duration, on the same curve. ---- */
+  --lift: 14px;
+  --dur-micro: 140ms;
+  --dur: 240ms;
+  --dur-slow: 420ms;
+  --dur-entrance: 620ms;
+  --dur-image: 620ms;
+  --stagger: 70ms;
+  --ease-out: cubic-bezier(0, 0, 0.28, 1);
+  --ease-inout: cubic-bezier(0.4, 0, 0.24, 1);
+}
+
+/* Reduced motion is expressed by flipping the tokens rather than by a blanket
+   !important reset. Every transition and animation in this stylesheet reads
+   its duration from one of these, so the preference reaches all of them —
+   including the ones a later rule adds — and nothing has to out-specify
+   anything. Durations become imperceptible rather than zero, so state changes
+   still fire their events. */
+/* On a phone the two smaller sizes come up to 15px and 16px. Small print is
+   still small print, but nothing on this site asks somebody to read body
+   copy below 15px on the device most of them are using. */
+@media (max-width: 48rem) {
+  :root {
+    --t-tiny: 0.9375rem;
+    --t-small: 1rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --lift: 0px;
+    --dur-micro: 0.01ms;
+    --dur: 0.01ms;
+    --dur-slow: 0.01ms;
+    --dur-entrance: 0.01ms;
+    --dur-image: 0.01ms;
+    --stagger: 0ms;
+  }
+
+  html { scroll-behavior: auto; }
+}
+
+/* ==========================================================================
+   02  RESET AND BASE
+   ========================================================================== */
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+  scroll-padding-top: 6rem;
+  background: var(--paper);
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--text);
+  font-family: var(--sans);
+  font-size: var(--t-body);
+  line-height: var(--lh-body);
+  font-synthesis-weight: none;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  overflow-x: hidden;
+}
+
+body.is-locked { overflow: hidden; }
+
+img, svg, video { display: block; max-width: 100%; }
+img { height: auto; }
+
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; }
+
+h1, h2, h3, h4, h5, h6 { margin: 0; font-weight: 400; }
+p, ul, ol, dl, figure, blockquote { margin: 0; }
+ul, ol { padding: 0; list-style: none; }
+
+a { color: inherit; text-decoration: none; }
+
+:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+  outline: 2px solid var(--ink);
+  outline-offset: 3px;
+  border-radius: var(--r-xs);
+}
+
+.on-ink :where(a, button, input, select, textarea, summary):focus-visible {
+  outline-color: var(--on-ink);
+}
+
+::selection { background: #cfd8ce; color: var(--text); }
+
+/* Grid and flex children default to a min-content floor, which is what lets
+   one long word push a column past the viewport at 200% zoom on a phone.
+   These are the containers this site lays out with. */
+:where(.split, .spread, .ways, .ledger, .contact-grid, .lenses, .article-grid,
+       .collection, .care, .annotated, .diff, .hero__grid, .price-hero__grid,
+       .anatomy__steps, .stat-rows > div, .facts > div, .direction__inner) > * {
+  min-width: 0;
+}
+
+:where(p, li, dd, dt, h1, h2, h3, h4, figcaption, summary) { overflow-wrap: break-word; }
+
+.direction__ref { flex-wrap: wrap; }
+
+.sr-only {
+  position: absolute;
+  width: 1px; height: 1px;
+  margin: -1px; padding: 0;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
+.skip-link {
+  position: absolute;
+  top: -100%;
+  left: var(--s-4);
+  z-index: 200;
+  padding: 0.75rem 1.15rem;
+  background: var(--ink);
+  color: var(--on-ink);
+  font-size: var(--t-small);
+  border-radius: var(--r);
+}
+
+.skip-link:focus { top: var(--s-4); }
+
+.site-content { display: block; min-height: 50vh; }
+.site-content:focus { outline: none; }
+
+/* ==========================================================================
+   03  TYPOGRAPHY
+   ========================================================================== */
+
+.t-display,
+.t-h1,
+.t-h2,
+.t-h3,
+h1, h2, h3 {
+  font-family: var(--serif);
+  color: var(--text);
+  letter-spacing: -0.014em;
+  text-wrap: balance;
+}
+
+.t-display {
+  font-size: var(--t-display);
+  line-height: var(--lh-display);
+  letter-spacing: -0.028em;
+}
+
+/* 200% zoom on a 390px phone leaves a 195px viewport. A display line has to
+   give way there — the alternative is a heading that runs off the page. */
+@media (max-width: 20rem) {
+  :root { --t-display: clamp(1.9rem, 9vw, 2.6rem); --t-h1: clamp(1.7rem, 8vw, 2.3rem); }
+  .t-display, h1, .t-h1 { hyphens: auto; }
+}
+
+h1, .t-h1 {
+  font-size: var(--t-h1);
+  line-height: var(--lh-heading);
+  letter-spacing: -0.022em;
+}
+
+h2, .t-h2 {
+  font-size: var(--t-h2);
+  line-height: 1.1;
+  letter-spacing: -0.018em;
+}
+
+h3, .t-h3 {
+  font-size: var(--t-h3);
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+}
+
+h4, .t-h4 {
+  font-family: var(--sans);
+  font-size: var(--t-h4);
+  font-weight: 600;
+  line-height: 1.35;
+  letter-spacing: -0.005em;
+}
+
+/* Optical alignment: trims the half-leading above and below a heading so it
+   sits on the grid rather than floating inside its own line box. Guarded —
+   it degrades to ordinary spacing where unsupported. */
+@supports (text-box: trim-both cap alphabetic) {
+  .t-display, .t-h1, .t-h2, h1, h2 { text-box: trim-both cap alphabetic; }
+}
+
+.lead {
+  max-width: 40ch;
+  color: var(--text-quiet);
+  font-size: var(--t-lead);
+  line-height: 1.5;
+  text-wrap: pretty;
+}
+
+.label {
+  display: block;
+  margin: 0 0 var(--s-4);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  line-height: 1.3;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.label--clay { color: var(--clay); }
+
+.quiet { color: var(--text-quiet); }
+.small { font-size: var(--t-small); max-width: 54ch; }
+.tiny  { font-size: var(--t-tiny); max-width: 54ch; }
+
+/* Any paragraph that is not already inside a narrow column still gets a
+   measure. Nothing on this site runs to 100 characters a line. */
+p.quiet:not(.small):not(.tiny) { max-width: 55ch; }
+
+.num {
+  font-family: var(--serif);
+  font-variant-numeric: tabular-nums lining-nums;
+}
+
+p { text-wrap: pretty; }
+
+/* Surfaces ---------------------------------------------------------------- */
+
+.on-paper { background: var(--paper); color: var(--text); }
+.on-paper-deep { background: var(--paper-deep); color: var(--text); }
+.on-sage { background: var(--sage); color: var(--text); }
+
+.on-ink {
+  background: var(--ink);
+  color: var(--on-ink);
+}
+
+.on-ink :is(h1, h2, h3, .t-display, .t-h1, .t-h2, .t-h3) { color: var(--on-ink); }
+.on-ink .lead,
+.on-ink .quiet,
+.on-ink p { color: var(--on-ink-quiet); }
+.on-ink .label { color: var(--on-ink-quiet); }
+
+.on-sage { --line: var(--line-on-sage); }
+
+/* ==========================================================================
+   04  LAYOUT
+   ========================================================================== */
+
+.wrap {
+  width: min(100% - (var(--gutter) * 2), var(--wrap));
+  margin-inline: auto;
+}
+
+/* Each variant is usable on its own, without also carrying .wrap. */
+.wrap--wide,
+.wrap--mid,
+.wrap--text { margin-inline: auto; }
+
+.wrap--wide { width: min(100% - (var(--gutter) * 2), var(--wrap-wide)); }
+.wrap--mid  { width: min(100% - (var(--gutter) * 2), var(--wrap-mid)); }
+.wrap--text { width: min(100% - (var(--gutter) * 2), var(--wrap-text)); }
+
+.band { padding-block: var(--band); }
+.band--lg { padding-block: var(--band-lg); }
+.band--sm { padding-block: var(--band-sm); }
+.band--flush-top { padding-block-start: 0; }
+.band--flush-bottom { padding-block-end: 0; }
+
+/* The editorial spread: a label column on the left, content on the right.
+   Below 1000px the label sits above the content instead. */
+.spread {
+  display: grid;
+  gap: var(--s-5) var(--s-7);
+  grid-template-columns: 1fr;
+}
+
+@media (min-width: 62rem) {
+  .spread {
+    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3.4fr);
+    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
+  }
+  .spread > .spread__aside { grid-column: 1; }
+  .spread > .spread__body { grid-column: 2; }
+}
+
+.split {
+  display: grid;
+  gap: var(--s-6);
+  grid-template-columns: 1fr;
+  align-items: start;
+}
+
+@media (min-width: 54rem) {
+  .split { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); }
+  .split--wide-left { grid-template-columns: 1.25fr 1fr; }
+  .split--wide-right { grid-template-columns: 1fr 1.25fr; }
+}
+
+.stack > * + * { margin-block-start: var(--flow, var(--s-4)); }
+
+/* A column of running text still gets a measure, whether or not the page
+   template remembered to give it one. */
+:where(.stack, .spread__body, .split, .split > div, .care, .ways > div) > :where(p, ul, ol):not(.field):not(.lead) {
+  max-width: 55ch;
+}
+.stack--tight { --flow: var(--s-3); }
+.stack--loose { --flow: var(--s-5); }
+.stack--wide  { --flow: var(--s-6); }
+
+.rule {
+  border: 0;
+  border-top: var(--hairline) solid var(--line);
+  margin: 0;
+}
+
+.section-head { max-width: 24ch; }
+.section-head + * { margin-block-start: var(--s-7); }
+
+/* ==========================================================================
+   05  MOTION
+   ========================================================================== */
+
+/* Every entrance in the site is this shape: 14px up, 620ms, one curve.
+   Two independent guards — the visitor's preference, then the browser's
+   capability. Where either is absent the page renders in its final state,
+   which is the state it was composed in. Nothing is hidden by default and
+   no script is required to reveal content. */
+
+@media (prefers-reduced-motion: no-preference) {
+
+  /* Entrance on load — hero material only. Supported everywhere. */
+  .enter {
+    animation: enter var(--dur-entrance) var(--ease-out) backwards;
+    animation-delay: calc(var(--i, 0) * var(--stagger));
+  }
+
+  @keyframes enter {
+    from { opacity: 0; transform: translate3d(0, var(--lift), 0); }
+  }
+
+  /* The plates settle rather than fade. Deliberately transform-only: they are
+     the largest thing on the page, and an opacity ramp from zero would hold
+     the largest contentful paint back by the length of the animation. */
+  @keyframes enter-plate {
+    from { transform: translate3d(0, 30px, 0) rotate(calc(var(--rot, 0deg) * -0.4)) scale(0.982); }
+  }
+
+  /* Entrance on scroll — everything below the fold. Scroll-driven, so the
+     browser owns the timing: no observer, no layout reads, no jank. */
+  @supports (animation-timeline: view()) {
+    .rise {
+      animation: enter linear both;
+      animation-timeline: view();
+      animation-range: entry 8% cover 26%;
+    }
+
+    .rise-group > * {
+      animation: enter linear both;
+      animation-timeline: view();
+      animation-range: entry 4% cover 24%;
+    }
+
+    /* Progressive line reveal, used by the process pathway and the
+       Practice Clarity diagram. */
+    .draw {
+      animation: draw linear both;
+      animation-timeline: view();
+      animation-range: entry 20% cover 55%;
+    }
+
+    @keyframes draw { from { stroke-dashoffset: var(--dash, 1000); } }
+
+    .step-in > * {
+      animation: enter linear both;
+      animation-timeline: view();
+      animation-range: entry 10% cover 40%;
+    }
+  }
+}
+
+/* ==========================================================================
+   06  ACTIONS
+   ========================================================================== */
+
+.btn {
+  --btn-bg: var(--ink);
+  --btn-fg: var(--on-ink);
+  position: relative;
+  display: inline-flex;
+  max-width: 100%;
+  align-items: center;
+  gap: 0.6em;
+  padding: 0.92rem 1.6rem;
+  min-height: 48px;
+  background: var(--btn-bg);
+  color: var(--btn-fg);
+  font-size: var(--t-small);
+  font-weight: 600;
+  line-height: 1.2;
+  letter-spacing: -0.005em;
+  border: var(--hairline) solid var(--btn-bg);
+  border-radius: 999px;
+  transition:
+    background var(--dur) var(--ease-inout),
+    color var(--dur) var(--ease-inout),
+    border-color var(--dur) var(--ease-inout);
+}
+
+.btn:hover { --btn-bg: var(--ink-deep); }
+
+.btn__arrow {
+  display: inline-block;
+  transition: transform var(--dur) var(--ease-out);
+}
+
+.btn:hover .btn__arrow { transform: translateX(3px); }
+
+.btn--quiet {
+  --btn-bg: transparent;
+  --btn-fg: var(--text);
+  border-color: var(--line-strong);
+}
+
+.btn--quiet:hover { --btn-bg: transparent; --btn-fg: var(--text); border-color: var(--ink); }
+
+.on-ink .btn {
+  --btn-bg: var(--on-ink);
+  --btn-fg: var(--ink);
+}
+
+.on-ink .btn:hover { --btn-bg: #ffffff; }
+
+.on-ink .btn--quiet {
+  --btn-bg: transparent;
+  --btn-fg: var(--on-ink);
+  border-color: var(--line-on-ink);
+}
+
+.on-ink .btn--quiet:hover { border-color: var(--on-ink); }
+
+/* The text link. One treatment, site-wide: a rule that grows from the left
+   on hover rather than a colour change. */
+.tlink {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 0.5em;
+  padding-block-end: 3px;
+  color: var(--text);
+  font-size: var(--t-small);
+  font-weight: 600;
+  background-image: linear-gradient(currentColor, currentColor);
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 100% 1px;
+  transition: background-size var(--dur-slow) var(--ease-out), color var(--dur) var(--ease-inout);
+}
+
+.tlink:hover { background-size: 100% 2px; }
+
+.tlink span[aria-hidden] { transition: transform var(--dur) var(--ease-out); }
+.tlink:hover span[aria-hidden] { transform: translateX(3px); }
+
+.on-ink .tlink { color: var(--on-ink); }
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--s-4) var(--s-5);
+}
+
+/* Inline links inside prose */
+.prose a,
+.inline-link {
+  color: var(--text);
+  background-image: linear-gradient(var(--line-strong), var(--line-strong));
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 100% 1px;
+  transition: background-size var(--dur) var(--ease-out), background-image var(--dur) var(--ease-out);
+}
+
+.prose a:hover,
+.inline-link:hover {
+  background-image: linear-gradient(currentColor, currentColor);
+  background-size: 100% 1px;
+}
+
+/* ==========================================================================
+   07  HEADER
+   ========================================================================== */
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 100;
+  background: color-mix(in srgb, var(--paper) 88%, transparent);
+  border-block-end: var(--hairline) solid transparent;
+  transition:
+    background var(--dur) var(--ease-inout),
+    border-color var(--dur) var(--ease-inout);
+}
+
+@supports (backdrop-filter: blur(6px)) {
+  .site-header { backdrop-filter: blur(10px) saturate(1.1); }
+}
+
+/* The scroll state is a flip, not a shrink: a hairline appears and the
+   ground becomes opaque. Nothing moves, so nothing reflows. */
+.site-header.is-scrolled {
+  background: color-mix(in srgb, var(--paper) 97%, transparent);
+  border-block-end-color: var(--line);
+}
+
+.nav {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-5);
+  width: min(100% - (var(--gutter) * 2), var(--wrap-wide));
+  margin-inline: auto;
+  min-height: 4.5rem;
+}
+
+.nav__brand { display: flex; align-items: center; padding-block: var(--s-3); }
+.nav__brand img { width: 168px; height: auto; }
+
+.nav__panel {
+  display: flex;
+  align-items: center;
+  gap: clamp(1.25rem, 2.6vw, 2.4rem);
+}
+
+.nav__links {
+  display: flex;
+  align-items: center;
+  gap: clamp(1rem, 2.2vw, 2rem);
+}
+
+.nav__links a,
+.nav__disclosure summary {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding-block: 0.35rem;
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+  font-weight: 500;
+  background-image: linear-gradient(currentColor, currentColor);
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 0 1px;
+  transition: color var(--dur) var(--ease-inout), background-size var(--dur) var(--ease-out);
+}
+
+.nav__links a:hover,
+.nav__disclosure summary:hover { color: var(--text); background-size: 100% 1px; }
+
+.nav__links a[aria-current="page"] { color: var(--text); background-size: 100% 1px; }
+
+.nav__disclosure { position: relative; }
+
+.nav__disclosure summary {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  gap: 0.4rem;
+  list-style: none;
+  cursor: pointer;
+}
+
+.nav__disclosure summary::-webkit-details-marker { display: none; }
+
+.nav__chev {
+  width: 7px; height: 7px;
+  border-right: 1.4px solid currentColor;
+  border-bottom: 1.4px solid currentColor;
+  transform: translateY(-2px) rotate(45deg);
+  transition: transform var(--dur) var(--ease-out);
+}
+
+.nav__disclosure[open] .nav__chev { transform: translateY(1px) rotate(-135deg); }
+
+.nav__submenu {
+  position: absolute;
+  top: calc(100% + 0.85rem);
+  left: -1rem;
+  min-width: 15rem;
+  padding: 0.85rem 0;
+  background: var(--paper);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--r);
+  box-shadow: 0 18px 40px -22px rgba(28, 42, 39, 0.4);
+}
+
+.nav__submenu a {
+  display: block;
+  padding: 0.5rem 1.25rem;
+  background-size: 0 1px;
+  font-size: var(--t-small);
+}
+
+.nav__submenu a:hover { background-size: 0 1px; color: var(--text); }
+
+.nav__cta {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.7rem 1.3rem;
+  background: var(--ink);
+  color: var(--on-ink);
+  font-size: var(--t-small);
+  font-weight: 600;
+  border-radius: 999px;
+  transition: background var(--dur) var(--ease-inout);
+}
+
+.nav__cta:hover { background: var(--ink-deep); }
+
+.nav__toggle {
+  display: none;
+  align-items: center;
+  gap: 0.55rem;
+  min-height: 44px;
+  padding: 0.5rem 0.25rem;
+  background: none;
+  border: 0;
+  color: var(--text);
+  font-size: var(--t-small);
+  font-weight: 600;
+}
+
+.nav__bars { position: relative; display: block; width: 20px; height: 10px; }
+
+.nav__bars::before,
+.nav__bars::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  width: 100%;
+  height: 1.4px;
+  background: currentColor;
+  transition: transform var(--dur) var(--ease-inout), opacity var(--dur-micro) linear;
+}
+
+.nav__bars::before { top: 0; }
+.nav__bars::after { bottom: 0; }
+
+.is-open .nav__bars::before { transform: translateY(4.3px) rotate(45deg); }
+.is-open .nav__bars::after { transform: translateY(-4.3px) rotate(-45deg); }
+
+@media (max-width: 61.99rem) {
+  .nav__toggle { display: inline-flex; }
+
+  .nav__panel {
+    position: fixed;
+    inset: 4.5rem 0 0 0;
+    z-index: 99;
+    display: grid;
+    align-content: start;
+    gap: var(--s-6);
+    padding: var(--s-7) var(--gutter) var(--s-8);
+    background: var(--paper);
+    border-block-start: var(--hairline) solid var(--line);
+    overflow-y: auto;
+    visibility: hidden;
+    opacity: 0;
+    transform: translateY(-8px);
+    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), visibility 0s linear var(--dur);
+  }
+
+  .nav__panel[data-open="true"] {
+    visibility: visible;
+    opacity: 1;
+    transform: none;
+    transition-delay: 0s;
+  }
+
+  .nav__links {
+    display: grid;
+    gap: 0;
+  }
+
+  .nav__links > li { border-block-end: var(--hairline) solid var(--line-soft); }
+
+  .nav__links a,
+  .nav__disclosure summary {
+    padding-block: var(--s-4);
+    font-family: var(--serif);
+    font-size: 1.45rem;
+    font-weight: 400;
+    color: var(--text);
+    background-size: 0 1px;
+  }
+
+  .nav__disclosure summary { justify-content: space-between; }
+
+  .nav__submenu {
+    position: static;
+    min-width: 0;
+    padding: 0 0 var(--s-4);
+    background: none;
+    border: 0;
+    box-shadow: none;
+  }
+
+  .nav__submenu a {
+    padding: var(--s-2) 0 var(--s-2) var(--s-4);
+    font-family: var(--sans);
+    font-size: var(--t-small);
+    color: var(--text-quiet);
+    border-left: var(--hairline) solid var(--line);
+  }
+
+  .nav__cta { justify-content: center; width: 100%; padding-block: 0.95rem; }
+}
+
+/* ==========================================================================
+   08  FOOTER
+   ========================================================================== */
+
+.site-footer {
+  padding-block: var(--band) var(--s-6);
+  background: var(--ink);
+  color: var(--on-ink);
+  --line: var(--line-on-ink);
+}
+
+.site-footer :is(h2, h3) { color: var(--on-ink); }
+
+.footer-top {
+  display: grid;
+  gap: var(--s-7);
+  padding-block-end: var(--s-7);
+  border-block-end: var(--hairline) solid var(--line-on-ink);
+}
+
+@media (min-width: 54rem) {
+  .footer-top { grid-template-columns: 1.4fr 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
+}
+
+.footer-mark {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--s-3) var(--s-4);
+  margin-block-end: var(--s-5);
+}
+
+.footer-mark img { filter: brightness(0) invert(1); opacity: 0.94; }
+.footer-mark .footer-submark { width: 42px; height: auto; flex: none; }
+.footer-mark .footer-word { width: min(154px, 46vw); height: auto; }
+.footer-mark .footer-divider { width: 1px; height: 34px; background: var(--line-on-ink); }
+
+.footer-note {
+  max-width: 40ch;
+  color: var(--on-ink-quiet);
+  font-size: var(--t-small);
+}
+
+.footer-group .label { color: var(--on-ink-quiet); margin-block-end: var(--s-4); }
+
+.footer-group a {
+  display: block;
+  padding-block: 0.42rem;
+  color: var(--on-ink);
+  font-size: var(--t-small);
+  background-image: linear-gradient(currentColor, currentColor);
+  background-repeat: no-repeat;
+  background-position: 0 calc(100% - 0.42rem);
+  background-size: 0 1px;
+  transition: background-size var(--dur) var(--ease-out);
+}
+
+.footer-group a:hover { background-size: 100% 1px; }
+
+.footer-bottom {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-4) var(--s-6);
+  padding-block-start: var(--s-6);
+}
+
+.footer-social { display: flex; gap: var(--s-3); }
+
+.footer-social a {
+  display: grid;
+  place-items: center;
+  width: 40px; height: 40px;
+  border: var(--hairline) solid var(--line-on-ink);
+  border-radius: 999px;
+  color: var(--on-ink-quiet);
+  transition: color var(--dur) var(--ease-inout), border-color var(--dur) var(--ease-inout);
+}
+
+.footer-social a:hover { color: var(--on-ink); border-color: var(--on-ink); }
+.footer-social svg { width: 17px; height: 17px; }
+
+.footer-legal {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--s-2) var(--s-5);
+}
+
+.footer-legal a,
+.footer-meta p {
+  color: var(--on-ink-quiet);
+  font-size: var(--t-tiny);
+}
+
+.footer-legal a {
+  display: inline-block;
+  padding-block: 0.4rem;
+  min-height: 26px;
+}
+
+.footer-legal a:hover { color: var(--on-ink); }
+
+.footer-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--s-3) var(--s-5);
+}
+
+/* ==========================================================================
+   09  DESIGN PLATES
+   The collection, drawn rather than photographed.
+
+   Each direction is rendered as a miniature of its own home page: its
+   palette, its typographic behaviour and — this is the part that carries the
+   range — its own layout personality. The container is identical every time;
+   what differs is the design inside it. That is what lets eight directions
+   read as eight directions rather than eight recolours.
+
+   Every dimension is in container query units, so one plate is correct at
+   180px in a footer and at 900px across a hero without a second stylesheet.
+   ========================================================================== */
+
+.plate {
+  container-type: inline-size;
+  position: relative;
+  display: block;
+  width: 100%;
+  --p-paper: #f3eee5;
+  --p-ink: #1f3027;
+  --p-soft: #75806d;
+  --p-accent: #c88e72;
+  --p-rule: color-mix(in srgb, var(--p-ink) 16%, transparent);
+}
+
+/* The sheet owns the proportion; the page inside it is absolutely placed so
+   content can never stretch the box. One ratio for every plate on a page,
+   whatever a given direction puts inside it. */
+.plate__sheet {
+  position: relative;
+  aspect-ratio: 4 / 3;
+  overflow: clip;
+  background: var(--p-paper);
+  color: var(--p-ink);
+  border: var(--hairline) solid color-mix(in srgb, var(--p-ink) 14%, transparent);
+  border-radius: var(--r-sm);
+  box-shadow: 0 1px 1px rgba(28, 42, 39, 0.04);
+}
+
+.plate__page {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto;
+}
+
+.plate--tall .plate__sheet { aspect-ratio: 3 / 4; }
+.plate--wide .plate__sheet { aspect-ratio: 16 / 10; }
+
+/* Masthead ---------------------------------------------------------------- */
+
+.plate__nav {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 3cqi;
+  padding: 3.4cqi 4.4cqi;
+  border-block-end: 1px solid var(--p-rule);
+}
+
+.plate__word {
+  font-family: var(--serif);
+  font-size: 3.5cqi;
+  line-height: 1;
+  letter-spacing: -0.01em;
+}
+
+.plate__menu { display: flex; gap: 2.4cqi; }
+
+.plate__menu i {
+  display: block;
+  width: 5.4cqi;
+  height: 0.85cqi;
+  background: color-mix(in srgb, var(--p-ink) 22%, transparent);
+  border-radius: 1px;
+}
+
+/* Hero -------------------------------------------------------------------- */
+
+.plate__hero {
+  display: grid;
+  grid-template-columns: 1.15fr 1fr;
+  gap: 4cqi;
+  align-items: center;
+  min-height: 0;
+  overflow: clip;
+  padding: 5cqi 4.4cqi;
+}
+
+.plate__eyebrow {
+  display: block;
+  margin-block-end: 2.4cqi;
+  color: color-mix(in srgb, var(--p-ink) 80%, transparent);
+  font-size: 1.85cqi;
+  font-weight: 600;
+  letter-spacing: 0.17em;
+  text-transform: uppercase;
+}
+
+.plate__title {
+  font-family: var(--serif);
+  font-size: 5.6cqi;
+  line-height: 1.08;
+  letter-spacing: -0.022em;
+  text-wrap: balance;
+}
+
+.plate__body {
+  display: grid;
+  gap: 1.5cqi;
+  margin-block-start: 3.2cqi;
+}
+
+.plate__body i {
+  display: block;
+  height: 0.9cqi;
+  background: color-mix(in srgb, var(--p-ink) 13%, transparent);
+  border-radius: 1px;
+}
+
+.plate__body i:last-child { width: 62%; }
+
+.plate__cta {
+  display: inline-block;
+  margin-block-start: 3.4cqi;
+  padding: 1.9cqi 3.6cqi;
+  background: var(--p-ink);
+  color: var(--p-paper);
+  font-size: 1.95cqi;
+  font-weight: 600;
+  letter-spacing: 0.01em;
+  border-radius: 999px;
+}
+
+/* Artwork. Overlapping fields of the direction's own palette — the shape
+   language changes per direction, which is most of what the eye reads. */
+
+.plate__art {
+  position: relative;
+  aspect-ratio: 1;
+  border-radius: 999px 999px 2px 2px;
+  overflow: clip;
+  background: color-mix(in srgb, var(--p-soft) 34%, var(--p-paper));
+}
+
+.plate__art span {
+  position: absolute;
+  display: block;
+  border-radius: 999px;
+}
+
+.plate__art span:nth-child(1) {
+  inset: 22% -12% -30% 18%;
+  background: var(--p-ink);
+  opacity: 0.9;
+}
+
+.plate__art span:nth-child(2) {
+  inset: -8% 26% 46% -14%;
+  background: var(--p-accent);
+  opacity: 0.85;
+}
+
+.plate__art span:nth-child(3) {
+  inset: 44% 44% 14% 12%;
+  background: color-mix(in srgb, var(--p-soft) 92%, #000);
+  opacity: 0.55;
+}
+
+/* Page-foot rows: a services index, or a set of audience routes ---------- */
+
+.plate__index { padding: 0 4.4cqi 4cqi; }
+
+.plate__index b {
+  display: flex;
+  justify-content: space-between;
+  gap: 2cqi;
+  padding-block: 1.8cqi;
+  border-block-start: 1px solid var(--p-rule);
+  font-family: var(--sans);
+  font-size: 2.1cqi;
+  font-weight: 500;
+}
+
+.plate__index b s { text-decoration: none; font-variant-numeric: tabular-nums; color: color-mix(in srgb, var(--p-ink) 80%, transparent); }
+.plate__index b em { font-style: normal; }
+
+.plate__routes {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 2.2cqi;
+  padding: 0 4.4cqi 4cqi;
+}
+
+.plate__routes b {
+  display: block;
+  padding: 2.2cqi 2cqi 3cqi;
+  background: color-mix(in srgb, var(--p-soft) 20%, var(--p-paper));
+  border-radius: 2.4cqi;
+  font-family: var(--serif);
+  font-size: 2.3cqi;
+  font-weight: 400;
+  line-height: 1.15;
+}
+
+/* Footer strip ------------------------------------------------------------ */
+
+.plate__strip {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+}
+
+.plate__strip span { display: block; height: 6.5cqi; }
+.plate__strip span:nth-child(1) { background: color-mix(in srgb, var(--p-accent) 42%, var(--p-paper)); }
+.plate__strip span:nth-child(2) { background: color-mix(in srgb, var(--p-soft) 40%, var(--p-paper)); }
+.plate__strip span:nth-child(3) { background: color-mix(in srgb, var(--p-ink) 88%, transparent); }
+
+/* --------------------------------------------------------------------------
+   Direction personalities
+   -------------------------------------------------------------------------- */
+
+/* Warm and grounded — space is the material. */
+.plate--warm .plate__hero { padding: 6cqi 5.6cqi; gap: 5cqi; }
+.plate--warm .plate__title { font-size: 5cqi; }
+.plate--warm .plate__art { border-radius: 999px 999px 1px 1px; background: color-mix(in srgb, var(--p-soft) 26%, var(--p-paper)); }
+.plate--warm .plate__art span { opacity: 1; }
+.plate--warm .plate__art span:nth-child(1) { inset: 56% 0 0 0; border-radius: 0; background: color-mix(in srgb, var(--p-ink) 92%, transparent); }
+.plate--warm .plate__art span:nth-child(2) { inset: 12% 14% 44% 14%; background: var(--p-accent); }
+.plate--warm .plate__art span:nth-child(3) { inset: 44% 46% 22% 12%; background: color-mix(in srgb, var(--p-soft) 88%, #000); opacity: 0.5; }
+.plate--warm .plate__nav { border-block-end-color: transparent; }
+
+/* Measured and editorial — rules, indices, tight measure. */
+.plate--editorial .plate__nav { padding-block: 2.8cqi; }
+.plate--editorial .plate__word { font-family: var(--sans); font-size: 2.3cqi; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
+.plate--editorial .plate__hero { grid-template-columns: 1fr 0.85fr; align-items: start; padding-block-start: 6cqi; }
+.plate--editorial .plate__title { font-size: 5.9cqi; letter-spacing: -0.03em; }
+.plate--editorial .plate__eyebrow { padding-block-end: 2.2cqi; border-block-end: 1px solid var(--p-rule); }
+.plate--editorial .plate__art { aspect-ratio: 3 / 4; border-radius: 2px; }
+.plate--editorial .plate__art { background: color-mix(in srgb, var(--p-soft) 18%, var(--p-paper)); }
+.plate--editorial .plate__art span { border-radius: 0; opacity: 1; }
+.plate--editorial .plate__art span:nth-child(1) { inset: 40% 0 0 24%; background: var(--p-ink); }
+.plate--editorial .plate__art span:nth-child(2) { inset: 0 34% 52% 0; background: var(--p-accent); }
+.plate--editorial .plate__art span:nth-child(3) { inset: 56% 58% 12% 6%; background: color-mix(in srgb, var(--p-soft) 82%, var(--p-paper)); }
+.plate--editorial .plate__cta { border-radius: 2px; }
+.plate--editorial .plate__strip span { height: 4.2cqi; }
+
+/* Protective and warm — soft forms, routes offered early. */
+.plate--care .plate__sheet { border-radius: var(--r-lg); }
+.plate--care .plate__hero { grid-template-columns: 1fr 0.8fr; padding: 4.4cqi 4.4cqi 3.2cqi; }
+.plate--care .plate__title { font-size: 4.5cqi; }
+.plate--care .plate__art { border-radius: 999px; }
+.plate--care .plate__art span:nth-child(1) { inset: 30% -6% -20% 24%; }
+.plate--care .plate__routes {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 2.2cqi;
+  padding: 0 4.4cqi 4cqi;
+}
+.plate--care .plate__routes b {
+  display: block;
+  padding: 2.2cqi 2cqi 3cqi;
+  background: color-mix(in srgb, var(--p-soft) 20%, var(--p-paper));
+  border-radius: 2.6cqi;
+  font-family: var(--serif);
+  font-size: 2.4cqi;
+  font-weight: 400;
+  line-height: 1.15;
+}
+.plate--care .plate__strip { display: none; }
+
+/* Calm and balanced — symmetry, nothing raised above anything else. */
+.plate--balance .plate__hero { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 2.6cqi; padding: 5cqi 10cqi 17cqi; align-content: start; overflow: visible; }
+.plate--balance .plate__title { font-size: 4.7cqi; max-width: 20ch; }
+.plate--balance .plate__body { justify-items: center; width: 64%; margin-block-start: 2.4cqi; }
+.plate--balance .plate__body i:last-child { width: 46%; margin-inline: auto; }
+.plate--balance .plate__cta { margin-block-start: 2.8cqi; }
+.plate--balance .plate__art {
+  position: absolute;
+  inset: auto 0 6.5cqi 0;
+  width: 100%;
+  height: 15cqi;
+  aspect-ratio: auto;
+  background: none;
+  border-radius: 0;
+  overflow: visible;
+}
+.plate--balance .plate__art span { bottom: 0; height: 100%; border-radius: 999px 999px 0 0; mix-blend-mode: multiply; }
+.plate--balance .plate__art span:nth-child(1) { inset: 0 auto 0 26%; width: 24%; background: color-mix(in srgb, var(--p-accent) 60%, var(--p-paper)); opacity: 1; }
+.plate--balance .plate__art span:nth-child(2) { inset: 14% auto 0 44%; width: 20%; background: color-mix(in srgb, var(--p-soft) 78%, var(--p-paper)); opacity: 1; }
+.plate--balance .plate__art span:nth-child(3) { inset: 6% auto 0 58%; width: 17%; background: var(--p-ink); opacity: 0.88; }
+.plate--balance .plate__strip { display: none; }
+.plate--balance .plate__art { inset: auto 0 0 0; height: 19cqi; }
+.plate--balance .plate__hero { padding-block-end: 20cqi; }
+
+/* Clear and neuroaffirming — direct language, visible choice, more colour. */
+.plate--choice .plate__nav { background: var(--p-ink); color: var(--p-paper); border-block-end: 0; }
+.plate--choice .plate__menu i { background: color-mix(in srgb, var(--p-paper) 48%, transparent); }
+.plate--choice .plate__hero { grid-template-columns: 1fr 0.62fr; gap: 4cqi; padding: 4.4cqi 4.4cqi 3cqi; align-items: start; }
+.plate--choice .plate__title { font-family: var(--sans); font-size: 4.5cqi; font-weight: 600; line-height: 1.08; letter-spacing: -0.03em; }
+.plate--choice .plate__art { aspect-ratio: 1; border-radius: 3cqi; background: none; }
+.plate--choice .plate__art span { border-radius: 2.4cqi; }
+.plate--choice .plate__art span:nth-child(1) { inset: 30% -10% -20% 26%; }
+.plate--choice .plate__routes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.2cqi; padding: 0 4.4cqi 4cqi; }
+.plate--choice .plate__routes b {
+  display: block;
+  padding: 2.2cqi 2.2cqi 3.4cqi;
+  font-family: var(--sans);
+  font-size: 2.2cqi;
+  font-weight: 600;
+  line-height: 1.2;
+  border-radius: 2.2cqi;
+}
+.plate--choice .plate__routes b:nth-child(1) { background: color-mix(in srgb, var(--p-accent) 40%, var(--p-paper)); }
+.plate--choice .plate__routes b:nth-child(2) { background: color-mix(in srgb, var(--p-soft) 40%, var(--p-paper)); }
+.plate--choice .plate__routes b:nth-child(3) { background: color-mix(in srgb, var(--p-ink) 16%, var(--p-paper)); }
+.plate--choice .plate__cta { border-radius: 999px; }
+.plate--choice .plate__strip { display: none; }
+
+/* Assured and clinical — an index, reference numbers, dense metadata. */
+.plate--clinical .plate__word { font-size: 3cqi; letter-spacing: 0.02em; }
+.plate--clinical .plate__hero { grid-template-columns: 1fr 0.66fr; align-items: start; padding-block: 4.2cqi 2.8cqi; }
+.plate--clinical .plate__title { font-size: 4.3cqi; }
+.plate--clinical .plate__art { aspect-ratio: 1; border-radius: 1px; background: color-mix(in srgb, var(--p-soft) 22%, var(--p-paper)); }
+.plate--clinical .plate__art span { border-radius: 0; opacity: 1; }
+.plate--clinical .plate__art span:nth-child(1) { inset: 0 52% 58% 0; background: color-mix(in srgb, var(--p-accent) 78%, var(--p-paper)); }
+.plate--clinical .plate__art span:nth-child(2) { inset: 46% 0 0 40%; background: var(--p-ink); }
+.plate--clinical .plate__art span:nth-child(3) { inset: 24% 30% 30% 26%; background: color-mix(in srgb, var(--p-soft) 70%, var(--p-paper)); }
+.plate--clinical .plate__index { padding: 0 4.4cqi 3.4cqi; }
+.plate--clinical .plate__index b {
+  display: grid;
+  grid-template-columns: 4cqi 1fr auto;
+  gap: 2.4cqi;
+  align-items: baseline;
+  padding-block: 1.65cqi;
+  border-block-start: 1px solid var(--p-rule);
+  font-family: var(--sans);
+  font-size: 2.05cqi;
+  font-weight: 500;
+}
+.plate--clinical .plate__index b em {
+  font-style: normal;
+  font-variant-numeric: tabular-nums;
+  color: color-mix(in srgb, var(--p-ink) 80%, transparent);
+}
+.plate--clinical .plate__index b s { text-decoration: none; color: color-mix(in srgb, var(--p-ink) 80%, transparent); }
+.plate--clinical .plate__cta { border-radius: 2px; }
+.plate--clinical .plate__strip { display: none; }
+
+/* Welcoming and practical — services and costs said out loud. */
+.plate--community .plate__word { font-family: var(--sans); font-weight: 700; font-size: 2.6cqi; letter-spacing: -0.01em; }
+.plate--community .plate__hero { grid-template-columns: 1fr 0.78fr; padding: 4.4cqi 4.4cqi 3cqi; }
+.plate--community .plate__title { font-size: 4.4cqi; }
+.plate--community .plate__art { border-radius: 999px; }
+.plate--community .plate__art span:nth-child(1) { inset: 30% -4% -18% 30%; }
+.plate--community .plate__art span:nth-child(2) { inset: -6% 34% 42% -8%; }
+.plate--community .plate__art span:nth-child(3) { inset: 34% 24% 6% 24%; opacity: 0.6; }
+.plate--community .plate__index { padding: 0 4.4cqi 3.4cqi; }
+.plate--community .plate__index b {
+  display: flex;
+  justify-content: space-between;
+  gap: 2cqi;
+  padding-block: 1.6cqi;
+  border-block-start: 1px solid var(--p-rule);
+  font-family: var(--sans);
+  font-size: 2.1cqi;
+  font-weight: 500;
+}
+.plate--community .plate__index b s { text-decoration: none; font-variant-numeric: tabular-nums; color: color-mix(in srgb, var(--p-ink) 80%, transparent); }
+.plate--community .plate__strip span { height: 4cqi; }
+
+/* Direct — one sentence, and room around it. */
+.plate--direct .plate__hero { grid-template-columns: 1fr; padding: 5.5cqi 6cqi 4cqi; align-content: center; overflow: visible; }
+.plate--direct .plate__title { font-size: 6cqi; max-width: 15ch; }
+.plate--direct .plate__art {
+  position: absolute;
+  inset: auto 5cqi 1cqi auto;
+  width: 24cqi;
+  height: 26cqi;
+  aspect-ratio: auto;
+  background: none;
+  border-radius: 999px 999px 1px 1px;
+  overflow: clip;
+}
+.plate--direct .plate__art span { inset: 0; border-radius: inherit; }
+.plate--direct .plate__art span:nth-child(1) { background: color-mix(in srgb, var(--p-soft) 55%, var(--p-paper)); opacity: 1; }
+.plate--direct .plate__art span:nth-child(2) { inset: 42% 0 0 0; border-radius: 0; background: var(--p-ink); opacity: 0.92; }
+.plate--direct .plate__art span:nth-child(3) { inset: 22% 34% 46% 18%; border-radius: 999px; background: var(--p-accent); opacity: 0.9; }
+.plate--direct .plate__strip { display: none; }
+.plate--direct .plate__art { inset: auto 6cqi 0 auto; height: 30cqi; border-radius: 999px 999px 0 0; }
+
+/* --------------------------------------------------------------------------
+   Plate framing and interaction
+   -------------------------------------------------------------------------- */
+
+.plate-frame {
+  position: relative;
+  display: block;
+  overflow: clip;
+  border-radius: var(--r-sm);
+}
+
+.plate-frame .plate {
+  transition: transform var(--dur-image) var(--ease-out);
+  will-change: transform;
+}
+
+/* The frame holds still; the work moves inside it. No lift, no shadow. */
+@media (hover: hover) and (prefers-reduced-motion: no-preference) {
+  a:hover > .plate-frame .plate,
+  a:focus-visible > .plate-frame .plate,
+  .plate-frame:hover .plate { transform: scale(1.022); }
+}
+
+.plate-caption {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-4);
+  margin-block-start: var(--s-4);
+  padding-block-start: var(--s-3);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+.plate-swatches { display: flex; gap: 5px; }
+
+.plate-swatches i {
+  display: block;
+  width: 13px; height: 13px;
+  border-radius: 999px;
+  border: var(--hairline) solid rgba(28, 42, 39, 0.14);
+}
+
+/* A phone view of the same direction, for the pairings where seeing both
+   answers a real question about the design. */
+.plate--phone .plate__sheet { aspect-ratio: 10 / 19; }
+.plate--phone .plate__nav { padding: 5cqi 6cqi; }
+.plate--phone .plate__word { font-size: 6cqi; }
+.plate--phone .plate__menu i { width: 9cqi; height: 1.5cqi; }
+.plate--phone .plate__menu i:nth-child(1),
+.plate--phone .plate__menu i:nth-child(2) { display: none; }
+.plate--phone .plate__hero { grid-template-columns: 1fr; align-content: start; gap: 5cqi; padding: 8cqi 6cqi; }
+.plate--phone .plate__eyebrow { font-size: 3.1cqi; margin-block-end: 3.6cqi; }
+.plate--phone .plate__title { font-size: 8.4cqi; }
+.plate--phone .plate__body { gap: 2.4cqi; margin-block-start: 5cqi; }
+.plate--phone .plate__body i { height: 1.6cqi; }
+.plate--phone .plate__cta { margin-block-start: 5cqi; padding: 3.4cqi 6cqi; font-size: 3.4cqi; }
+.plate--phone .plate__art { aspect-ratio: 4 / 3; }
+.plate--phone .plate__routes,
+.plate--phone .plate__index { display: none; }
+.plate--phone .plate__strip span { height: 11cqi; }
+
+/* ==========================================================================
+   10  HOME
+   ========================================================================== */
+
+.hero {
+  padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem);
+  overflow: clip;
+}
+
+.hero__grid {
+  display: grid;
+  gap: clamp(3rem, 6vw, 5rem);
+  align-items: center;
+}
+
+@media (min-width: 62rem) {
+  .hero__grid {
+    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
+    gap: clamp(2rem, 4vw, 4.5rem);
+  }
+}
+
+.hero__copy { max-width: 34rem; }
+.hero__copy .t-display { margin-block: var(--s-4) var(--s-5); }
+.hero__copy .lead { max-width: 33ch; }
+.hero__actions { margin-block-start: var(--s-6); }
+
+.hero__price {
+  display: grid;
+  gap: var(--s-2);
+  margin-block-start: var(--s-6);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+}
+
+.hero__price p { max-width: 42ch; }
+
+.hero__price b {
+  margin-inline-end: 0.15em;
+  font-family: var(--serif);
+  font-size: 1.4rem;
+  font-weight: 400;
+  color: var(--text);
+  letter-spacing: -0.02em;
+  font-variant-numeric: lining-nums;
+}
+
+.hero__price-note { color: var(--text-faint); font-size: var(--t-tiny); }
+
+/* The fan. Three directions, laid down like plates on a table. */
+
+.fan {
+  position: relative;
+  aspect-ratio: 5 / 4.1;
+}
+
+/* Where the hero is two columns, the fan runs out into the gutter so the
+   right-hand plate finishes flush with the page edge — a bleed, but one that
+   stops at the viewport rather than past it. */
+@media (min-width: 62rem) {
+  .fan { margin-inline-end: calc(var(--gutter) * -1); }
+}
+
+.fan__item {
+  position: absolute;
+  filter: drop-shadow(0 24px 44px rgba(28, 42, 39, 0.14));
+}
+
+.fan__item:nth-child(1) { z-index: 1; width: 64%; left: 0;    top: 10%; rotate: -3.2deg; }
+.fan__item:nth-child(2) { z-index: 2; width: 60%; right: 2%; top: 0;   rotate: 2.6deg; }
+.fan__item:nth-child(3) { z-index: 3; width: 76%; left: 12%;  bottom: 0; rotate: -0.6deg; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .fan__item { animation: enter-plate 820ms var(--ease-out) backwards; }
+  .fan__item:nth-child(1) { --rot: -3.2deg; animation-delay: 90ms; }
+  .fan__item:nth-child(2) { --rot: 2.6deg;  animation-delay: 0ms; }
+  .fan__item:nth-child(3) { --rot: -0.6deg; animation-delay: 170ms; }
+
+  /* A few pixels of parallax as the hero leaves — enough to register depth,
+     not enough to notice as an effect. */
+  @supports (animation-timeline: view()) {
+    .fan__item {
+      animation:
+        enter-plate 820ms var(--ease-out) backwards,
+        drift linear both;
+      animation-timeline: auto, view();
+      animation-range: normal, cover 0% cover 100%;
+    }
+    .fan__item:nth-child(1) { --drift: 34px; }
+    .fan__item:nth-child(2) { --drift: 14px; }
+    .fan__item:nth-child(3) { --drift: -22px; }
+
+    @keyframes drift {
+      from { translate: 0 calc(var(--drift, 0px) * -0.5); }
+      to   { translate: 0 calc(var(--drift, 0px) * 0.5); }
+    }
+  }
+}
+
+@media (max-width: 61.99rem) {
+  /* Single column: the fan is inside the measure, so the rotated bounding
+     boxes have to be inside it too. */
+  .fan__item:nth-child(1) { width: 58%; left: 2%; top: 4%; rotate: -2.6deg; }
+  .fan__item:nth-child(2) { width: 52%; right: 2%; top: 0; rotate: 2.2deg; }
+  .fan__item:nth-child(3) { width: 68%; left: 16%; bottom: 0; rotate: -0.6deg; }
+}
+
+@media (max-width: 45rem) {
+  .fan { aspect-ratio: 4 / 3.4; }
+  .fan__item:nth-child(1) { width: 56%; left: 2%; top: 0; rotate: -2deg; }
+  .fan__item:nth-child(2) { display: none; }
+  .fan__item:nth-child(3) { width: 76%; left: 20%; bottom: 0; rotate: 0deg; }
+}
+
+/* Home: the two ways to begin ---------------------------------------------- */
+
+.ways {
+  display: grid;
+  gap: var(--s-7);
+}
+
+@media (min-width: 54rem) {
+  .ways {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: clamp(2.5rem, 6vw, 6rem);
+  }
+  .ways > * + * {
+    padding-inline-start: clamp(2.5rem, 6vw, 6rem);
+    border-inline-start: var(--hairline) solid var(--line);
+  }
+}
+
+.way__said {
+  max-width: 22ch;
+  font-family: var(--serif);
+  font-size: clamp(1.4rem, 1.1rem + 1.1vw, 1.95rem);
+  line-height: 1.22;
+  letter-spacing: -0.018em;
+  text-wrap: balance;
+}
+
+.way__said::before { content: "\201C"; }
+.way__said::after { content: "\201D"; }
+
+.way__meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  margin-block-start: var(--s-6);
+  padding-block-end: var(--s-3);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+.way__name { font-family: var(--sans); font-size: var(--t-h4); font-weight: 600; }
+
+.way__price {
+  font-family: var(--serif);
+  font-size: 1.6rem;
+  font-variant-numeric: lining-nums;
+  letter-spacing: -0.02em;
+}
+
+.way__list { margin-block-start: var(--s-4); }
+
+.way__list li {
+  padding-block: var(--s-2);
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+}
+
+.way__list li + li { border-block-start: var(--hairline) solid var(--line-soft); }
+
+.way__actions { margin-block-start: var(--s-5); }
+
+/* Home: studio facts ------------------------------------------------------- */
+
+.facts { border-block-start: var(--hairline) solid var(--line); }
+
+.facts > div {
+  display: grid;
+  gap: var(--s-1) var(--s-5);
+  padding-block: var(--s-4);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+@media (min-width: 40rem) {
+  .facts > div { grid-template-columns: 10rem minmax(0, 1fr); align-items: baseline; }
+}
+
+.facts dt { font-size: var(--t-small); font-weight: 600; }
+.facts dd { margin: 0; color: var(--text-quiet); font-size: var(--t-small); }
+
+/* ==========================================================================
+   11  COLLECTION
+   ========================================================================== */
+
+.collection {
+  display: grid;
+  gap: clamp(3rem, 6vw, 5.5rem) clamp(1.75rem, 3.4vw, 3rem);
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.collection--three { gap: clamp(2.25rem, 4vw, 3.5rem) clamp(1.5rem, 2.6vw, 2.25rem); }
+
+@media (min-width: 62rem) {
+  .collection--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (max-width: 45rem) {
+  .collection { grid-template-columns: 1fr; }
+}
+
+/* A direction that earns the full measure. Used once or twice per page so the
+   grid has a rhythm rather than a repeat. */
+.collection > .direction--feature { grid-column: 1 / -1; }
+
+@media (min-width: 62rem) {
+  .direction--feature .direction__inner {
+    display: grid;
+    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
+    gap: clamp(2rem, 4vw, 4rem);
+    align-items: center;
+  }
+  .direction--feature .direction__meta { padding-block-start: 0; border-block-start: 0; }
+  .direction--feature .direction__name { font-size: var(--t-h2); }
+}
+
+.direction { display: block; }
+
+.direction__link { display: block; }
+
+.direction__meta {
+  display: grid;
+  gap: var(--s-3);
+  margin-block-start: var(--s-5);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+.direction__ref {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-4);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.direction__name {
+  font-family: var(--serif);
+  font-size: var(--t-h3);
+  line-height: 1.15;
+  letter-spacing: -0.016em;
+}
+
+.direction__note { max-width: 46ch; color: var(--text-quiet); font-size: var(--t-small); }
+
+.direction__foot {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-3) var(--s-4);
+  margin-block-start: var(--s-1);
+}
+
+.tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
+
+.tags li {
+  padding: 0.28rem 0.68rem;
+  border: var(--hairline) solid var(--line);
+  border-radius: 999px;
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.direction__go {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.45em;
+  font-size: var(--t-small);
+  font-weight: 600;
+}
+
+.direction__go span[aria-hidden] { transition: transform var(--dur) var(--ease-out); }
+.direction__link:hover .direction__go span[aria-hidden] { transform: translate(3px, -3px); }
+
+/* Filters ------------------------------------------------------------------ */
+
+.library-tools {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: end;
+  justify-content: space-between;
+  gap: var(--s-4) var(--s-6);
+  padding-block-end: var(--s-5);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+.chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
+
+.chips button {
+  min-height: 44px;
+  padding: 0.6rem 1rem;
+  background: none;
+  color: var(--text-quiet);
+  font-size: var(--t-tiny);
+  font-weight: 500;
+  border: var(--hairline) solid var(--line);
+  border-radius: 999px;
+  transition: color var(--dur) var(--ease-inout), border-color var(--dur) var(--ease-inout), background var(--dur) var(--ease-inout);
+}
+
+.chips button:hover { border-color: var(--line-strong); color: var(--text); }
+
+.chips button[aria-pressed="true"] {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--on-ink);
+}
+
+.search-field { display: grid; gap: var(--s-2); flex: 1 1 15rem; min-width: 0; max-width: 22rem; }
+
+.search-field span {
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.search-field input {
+  min-width: 0;
+  min-height: 44px;
+  padding: 0.5rem 0;
+  background: none;
+  border: 0;
+  border-block-end: var(--hairline) solid var(--line-strong);
+  font-size: var(--t-small);
+}
+
+.search-field input::placeholder { color: var(--text-faint); }
+.search-field input:focus { outline: none; border-block-end-color: var(--ink); }
+.search-field:focus-within span { color: var(--text); }
+
+.results-line {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  padding-block: var(--s-4) var(--s-7);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.no-results { padding-block: var(--s-8); text-align: center; }
+.no-results p { margin-block: var(--s-3) var(--s-5); color: var(--text-quiet); }
+
+/* ==========================================================================
+   12  INFORMATION DESIGN
+   Diagrams that belong to this brand: a rule, a tick, a numeral, a label.
+   No boxes, no arrows, no circled steps.
+   ========================================================================== */
+
+/* --- The anatomy of the service: one line, seven marks ------------------- */
+
+.anatomy { --anatomy-steps: 7; }
+
+.anatomy__head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3) var(--s-5);
+  padding-block-end: var(--s-4);
+}
+
+.anatomy__price {
+  font-family: var(--serif);
+  font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
+  line-height: 1;
+  letter-spacing: -0.03em;
+  font-variant-numeric: lining-nums;
+}
+
+.anatomy__price small {
+  display: block;
+  margin-block-start: var(--s-2);
+  color: var(--text-quiet);
+  font-family: var(--sans);
+  font-size: var(--t-small);
+  letter-spacing: 0;
+}
+
+.anatomy__track { position: relative; }
+
+.anatomy__rule {
+  position: absolute;
+  inset-block-start: 0;
+  inset-inline: 0;
+  height: 1px;
+  background: var(--line-strong);
+  transform-origin: left center;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  @supports (animation-timeline: view()) {
+    .anatomy__rule {
+      animation: grow-x linear both;
+      animation-timeline: view();
+      animation-range: entry 25% cover 48%;
+    }
+    @keyframes grow-x { from { transform: scaleX(0); } }
+  }
+}
+
+.anatomy__steps {
+  display: grid;
+  gap: var(--s-5) var(--s-4);
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+@media (min-width: 48rem) { .anatomy__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+@media (min-width: 72rem) { .anatomy__steps { grid-template-columns: repeat(var(--anatomy-steps), minmax(0, 1fr)); gap: var(--s-4); } }
+
+.anatomy__step { position: relative; padding-block-start: var(--s-5); }
+
+.anatomy__step::before {
+  content: "";
+  position: absolute;
+  inset-block-start: 0;
+  inset-inline-start: 0;
+  width: 1px;
+  height: 12px;
+  background: var(--line-strong);
+}
+
+.anatomy__step--end::before { width: 3px; background: var(--clay); }
+
+.anatomy__n {
+  display: block;
+  margin-block-end: var(--s-2);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  font-variant-numeric: tabular-nums;
+}
+
+.anatomy__step h3 {
+  font-family: var(--sans);
+  font-size: var(--t-small);
+  font-weight: 600;
+  line-height: 1.3;
+  letter-spacing: 0;
+}
+
+.anatomy__step p {
+  margin-block-start: var(--s-2);
+  color: var(--text-quiet);
+  font-size: var(--t-tiny);
+  line-height: 1.5;
+}
+
+.anatomy__note {
+  margin-block-start: var(--s-7);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  max-width: 56ch;
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+}
+
+/* --- The ledger: what is in, what you bring, what is not ----------------- */
+
+.ledger {
+  display: grid;
+  gap: var(--s-6) clamp(2rem, 4vw, 3.5rem);
+}
+
+@media (min-width: 54rem) { .ledger { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+
+.ledger__col > .label { padding-block-end: var(--s-3); border-block-end: var(--hairline) solid var(--line-strong); }
+
+.ledger__col li {
+  padding-block: var(--s-3);
+  border-block-end: var(--hairline) solid var(--line-soft);
+  font-size: var(--t-small);
+  line-height: 1.5;
+}
+
+.ledger__col--out li { color: var(--text-quiet); }
+
+.ledger__col--out li::before {
+  content: "\2014";
+  margin-inline-end: 0.5em;
+  color: var(--text-faint);
+}
+
+/* --- The pathway: Practice Clarity, drawn ------------------------------- */
+
+.pathway {
+  display: grid;
+  gap: 0;
+  counter-reset: stage;
+}
+
+.pathway__stage {
+  position: relative;
+  display: grid;
+  gap: var(--s-2) clamp(1.5rem, 4vw, 3.5rem);
+  padding: var(--s-5) 0 var(--s-5) var(--s-6);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+.pathway__stage:last-child { border-block-end: var(--hairline) solid var(--line); }
+
+@media (min-width: 48rem) {
+  .pathway__stage { grid-template-columns: 12rem minmax(0, 1fr); align-items: baseline; }
+}
+
+/* The connecting line runs down the left edge and is drawn as you read. */
+.pathway__stage::before {
+  content: "";
+  position: absolute;
+  inset-block: 0;
+  inset-inline-start: 0.55rem;
+  width: 1px;
+  background: var(--line-strong);
+  transform-origin: top center;
+}
+
+.pathway__stage::after {
+  content: "";
+  position: absolute;
+  inset-block-start: calc(var(--s-5) + 0.42em);
+  inset-inline-start: calc(0.55rem - 3px);
+  width: 7px; height: 7px;
+  background: var(--paper);
+  border: 1px solid var(--text);
+  border-radius: 999px;
+}
+
+.pathway__stage--final::after { background: var(--clay); border-color: var(--clay); }
+
+@media (prefers-reduced-motion: no-preference) {
+  @supports (animation-timeline: view()) {
+    .pathway__stage::before {
+      animation: grow-y linear both;
+      animation-timeline: view();
+      animation-range: entry 30% cover 50%;
+    }
+    @keyframes grow-y { from { transform: scaleY(0); } }
+  }
+}
+
+.pathway__name {
+  font-family: var(--serif);
+  font-size: var(--t-h3);
+  line-height: 1.2;
+  letter-spacing: -0.014em;
+}
+
+.pathway__q { color: var(--text-quiet); font-size: var(--t-small); text-wrap: pretty; }
+
+.pathway__out {
+  margin-block-start: var(--s-5);
+  padding-block-start: var(--s-4);
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+  max-width: 54ch;
+}
+
+/* --- The tailoring diff: a direction, and one practice's version -------- */
+
+.diff {
+  display: grid;
+  gap: clamp(2rem, 5vw, 4rem);
+}
+
+@media (min-width: 54rem) { .diff { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+.diff__label {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-3);
+  margin-block-end: var(--s-4);
+  padding-block-end: var(--s-3);
+  border-block-end: var(--hairline) solid var(--line-strong);
+}
+
+.diff__notes { margin-block-start: var(--s-6); counter-reset: note; }
+
+.diff__notes li {
+  position: relative;
+  display: grid;
+  gap: var(--s-1) var(--s-4);
+  padding: var(--s-4) 0 var(--s-4) 2.4rem;
+  border-block-start: var(--hairline) solid var(--line-soft);
+  font-size: var(--t-small);
+}
+
+@media (min-width: 40rem) {
+  .diff__notes li { grid-template-columns: 11rem minmax(0, 1fr); align-items: baseline; }
+}
+
+.diff__notes li::before {
+  counter-increment: note;
+  content: counter(note, decimal-leading-zero);
+  position: absolute;
+  inset-inline-start: 0;
+  inset-block-start: var(--s-4);
+  color: var(--clay);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.1em;
+  font-variant-numeric: tabular-nums;
+}
+
+.diff__notes b { font-weight: 600; }
+.diff__notes span { max-width: 54ch; color: var(--text-quiet); }
+
+/* --- The annotated anatomy of a therapist home page --------------------- */
+
+.annotated {
+  display: grid;
+  gap: clamp(2rem, 5vw, 4rem);
+  align-items: start;
+}
+
+@media (min-width: 62rem) { .annotated { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); } }
+
+.annotated__keys { counter-reset: key; }
+
+.annotated__keys li {
+  display: grid;
+  grid-template-columns: 1.7rem minmax(0, 1fr);
+  gap: var(--s-4);
+  padding-block: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  font-size: var(--t-small);
+}
+
+.annotated__keys li:last-child { border-block-end: var(--hairline) solid var(--line); }
+
+.annotated__keys li::before {
+  counter-increment: key;
+  content: counter(key, lower-alpha);
+  display: grid;
+  place-items: center;
+  width: 1.35rem; height: 1.35rem;
+  margin-block-start: 0.1rem;
+  border: 1px solid var(--text);
+  border-radius: 999px;
+  font-size: var(--t-tiny);
+  font-weight: 600;
+}
+
+.annotated__keys b { display: block; font-weight: 600; }
+.annotated__keys span { color: var(--text-quiet); }
+
+/* Callout markers pinned onto the plate */
+.marker {
+  position: absolute;
+  z-index: 5;
+  display: grid;
+  place-items: center;
+  width: 1.55rem; height: 1.55rem;
+  background: var(--paper);
+  border: 1px solid var(--text);
+  border-radius: 999px;
+  font-size: var(--t-tiny);
+  font-weight: 600;
+  line-height: 1;
+}
+
+/* --- Care ---------------------------------------------------------------- */
+
+.care {
+  display: grid;
+  gap: var(--s-6) clamp(2rem, 5vw, 4.5rem);
+  align-items: start;
+}
+
+@media (min-width: 54rem) { .care { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
+
+.care__figure {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--s-2) var(--s-4);
+  padding-block-end: var(--s-4);
+  border-block-end: var(--hairline) solid var(--line-strong);
+}
+
+.care__figure b {
+  font-family: var(--serif);
+  font-size: clamp(1.9rem, 1.4rem + 1.7vw, 2.7rem);
+  font-weight: 400;
+  letter-spacing: -0.025em;
+  font-variant-numeric: lining-nums;
+}
+
+.care__list li {
+  padding-block: var(--s-3);
+  border-block-end: var(--hairline) solid var(--line-soft);
+  font-size: var(--t-small);
+}
+
+.care__list--out li { color: var(--text-quiet); }
+.care__list--out li::before { content: "\2014"; margin-inline-end: 0.5em; color: var(--text-faint); }
+
+/* ==========================================================================
+   13  PRICES AND SCOPE
+   ========================================================================== */
+
+.price-hero { padding-block: clamp(3.5rem, 7vw, 7rem) clamp(3rem, 5vw, 5rem); }
+
+.price-hero__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: end; }
+
+@media (min-width: 62rem) {
+  .price-hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
+}
+
+.figure-large {
+  font-family: var(--serif);
+  font-size: clamp(4rem, 2rem + 9vw, 8.5rem);
+  line-height: 0.92;
+  letter-spacing: -0.045em;
+  font-variant-numeric: lining-nums;
+}
+
+.figure-large sup {
+  font-size: 0.34em;
+  top: -1.3em;
+  margin-inline-start: 0.15em;
+  letter-spacing: 0;
+  vertical-align: super;
+}
+
+.offer-row {
+  display: grid;
+  gap: var(--s-4) clamp(2rem, 5vw, 4rem);
+  padding-block: var(--s-6);
+  border-block-start: var(--hairline) solid var(--line);
+  align-items: start;
+}
+
+@media (min-width: 54rem) {
+  .offer-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) auto; }
+}
+
+.offer-row:last-of-type { border-block-end: var(--hairline) solid var(--line); }
+
+.offer-row__name { display: grid; gap: var(--s-2); }
+
+.offer-row__name h3 { font-family: var(--serif); font-size: var(--t-h3); }
+
+.offer-row__price {
+  font-family: var(--serif);
+  font-size: 1.5rem;
+  letter-spacing: -0.02em;
+  font-variant-numeric: lining-nums;
+}
+
+.offer-row__body { color: var(--text-quiet); font-size: var(--t-small); max-width: 52ch; }
+.offer-row__body p + p { margin-block-start: var(--s-3); }
+
+.faq { display: grid; gap: 0; }
+
+.faq details {
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+.faq details:last-of-type { border-block-end: var(--hairline) solid var(--line); }
+
+.faq summary {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s-5);
+  padding-block: var(--s-5);
+  list-style: none;
+  cursor: pointer;
+  font-family: var(--serif);
+  font-size: var(--t-h3);
+  line-height: 1.25;
+  letter-spacing: -0.014em;
+}
+
+.faq summary::-webkit-details-marker { display: none; }
+
+.faq summary::after {
+  content: "";
+  flex: none;
+  width: 12px; height: 12px;
+  margin-block-start: 0.35em;
+  border-right: 1px solid currentColor;
+  border-bottom: 1px solid currentColor;
+  transform: rotate(45deg);
+  transition: transform var(--dur) var(--ease-out);
+}
+
+.faq details[open] summary::after { transform: rotate(-135deg) translate(-3px, -3px); }
+
+.faq__body {
+  padding-block-end: var(--s-5);
+  max-width: 55ch;
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+}
+
+.faq__body p + p { margin-block-start: var(--s-3); }
+
+/* ==========================================================================
+   14  ABOUT
+   ========================================================================== */
+
+.portrait {
+  position: relative;
+  overflow: clip;
+  border-radius: var(--r-sm);
+  background: var(--paper-deep);
+}
+
+.portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
+.portrait--wide img { aspect-ratio: 16 / 10; }
+
+.portrait figcaption {
+  padding-block-start: var(--s-3);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.lenses { display: grid; gap: 0; }
+
+@media (min-width: 54rem) { .lenses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+.lens { padding: clamp(2rem, 4vw, 3.25rem); }
+.lens--paper { background: var(--paper); }
+.lens--ink { background: var(--ink); color: var(--on-ink); }
+.lens--ink :is(h2, h3) { color: var(--on-ink); }
+.lens--ink p { color: var(--on-ink-quiet); }
+.lens h3 { max-width: 20ch; margin-block: var(--s-4) var(--s-4); font-size: var(--t-h3); }
+.lens p { font-size: var(--t-small); }
+
+.stat-rows { border-block-start: var(--hairline) solid var(--line); }
+
+.stat-rows > div {
+  display: grid;
+  gap: var(--s-1) var(--s-5);
+  padding-block: var(--s-4);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+@media (min-width: 40rem) { .stat-rows > div { grid-template-columns: 12rem minmax(0, 1fr); align-items: baseline; } }
+
+.stat-rows dt { font-size: var(--t-small); font-weight: 600; }
+.stat-rows dt .inline-link { display: inline-block; padding-block: 0.25rem; min-height: 26px; }
+.stat-rows dd { margin: 0; color: var(--text-quiet); font-size: var(--t-small); }
+
+/* ==========================================================================
+   15  CONTACT AND FORMS
+   ========================================================================== */
+
+.form { display: grid; gap: var(--s-5); }
+
+.field,
+.form > label,
+.form fieldset > label:not(.check) { display: grid; gap: var(--s-2); }
+
+.field > label,
+.field > .field__label,
+.form > label > span:first-child,
+.form fieldset > label:not(.check) > span:first-child {
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.field input,
+.field select,
+.field textarea,
+.form input:not([type="checkbox"]):not([type="radio"]),
+.form select,
+.form textarea {
+  width: 100%;
+  min-height: 48px;
+  padding: 0.75rem 0.9rem;
+  background: var(--paper);
+  border: var(--hairline) solid var(--line-strong);
+  border-radius: var(--r-sm);
+  font-size: var(--t-small);
+  transition: border-color var(--dur) var(--ease-inout), background var(--dur) var(--ease-inout);
+}
+
+.field textarea,
+.form textarea { min-width: 0; min-height: 9rem; resize: vertical; line-height: 1.55; }
+
+.field input:hover,
+.field select:hover,
+.field textarea:hover,
+.form input:not([type="checkbox"]):hover,
+.form select:hover,
+.form textarea:hover { border-color: var(--text-faint); }
+
+.field input:focus,
+.field select:focus,
+.field textarea:focus,
+.form input:not([type="checkbox"]):focus,
+.form select:focus,
+.form textarea:focus {
+  outline: 2px solid var(--ink);
+  outline-offset: 1px;
+  border-color: var(--ink);
+}
+
+.field__hint,
+.form .field__hint {
+  display: block;
+  max-width: 54ch;
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+/* Required/optional markers used by the intake questionnaire. */
+.req, .opt {
+  display: inline-block;
+  margin-inline-start: 0.5em;
+  padding: 0.05em 0.45em;
+  border: var(--hairline) solid var(--line);
+  border-radius: 999px;
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+  font-weight: 500;
+  letter-spacing: 0.02em;
+  text-transform: none;
+}
+
+.req { border-color: var(--line-strong); color: var(--text-quiet); }
+
+.field-row { display: grid; gap: var(--s-5); }
+@media (min-width: 40rem) { .field-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+fieldset { margin: 0; padding: 0; border: 0; }
+
+legend {
+  padding: 0 0 var(--s-4);
+  font-family: var(--serif);
+  font-size: var(--t-h3);
+  letter-spacing: -0.014em;
+}
+
+.check {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  gap: var(--s-3);
+  align-items: start;
+  padding-block: var(--s-2);
+  font-size: var(--t-small);
+}
+
+.check input { width: 24px; height: 24px; min-height: 24px; margin-block-start: 0.1rem; accent-color: var(--ink); }
+
+.form-panel {
+  min-width: 0;
+  padding: clamp(1.75rem, 4vw, 2.75rem);
+  background: var(--paper);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--r);
+}
+
+.on-sage .form-panel { background: var(--paper); }
+
+.contact-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
+.contact-grid > * { min-width: 0; }
+
+@media (min-width: 62rem) {
+  .contact-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
+}
+
+.contact-email {
+  display: inline-block;
+  max-width: 100%;
+  overflow-wrap: anywhere;
+  font-family: var(--serif);
+  font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
+  letter-spacing: -0.02em;
+  background-image: linear-gradient(var(--line-strong), var(--line-strong));
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 100% 1px;
+  transition: background-size var(--dur) var(--ease-out);
+}
+
+.contact-email:hover { background-size: 100% 2px; }
+
+/* ==========================================================================
+   16  LIBRARY, JOURNAL, ARTICLES
+   ========================================================================== */
+
+.article-grid {
+  display: grid;
+  gap: clamp(2rem, 4vw, 3rem);
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
+}
+
+.article-grid > * { min-width: 0; }
+
+.article-card { display: grid; grid-template-rows: subgrid; }
+
+.article-card__link { display: grid; gap: var(--s-4); height: 100%; align-content: start; }
+
+.article-card__media {
+  overflow: clip;
+  aspect-ratio: 16 / 10;
+  border-radius: var(--r-sm);
+  background: var(--paper-deep);
+}
+
+.article-card__media img {
+  width: 100%; height: 100%;
+  object-fit: cover;
+  transition: transform var(--dur-image) var(--ease-out);
+}
+
+@media (hover: hover) and (prefers-reduced-motion: no-preference) {
+  .article-card__link:hover .article-card__media img { transform: scale(1.03); }
+}
+
+.article-card__meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--s-2) var(--s-4);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.article-card h3 { font-size: var(--t-h3); }
+.article-card p { max-width: 46ch; color: var(--text-quiet); font-size: var(--t-small); }
+
+/* The principle index — nine principles, one page, no wall of prose. */
+
+.principles { border-block-start: var(--hairline) solid var(--line); }
+
+.principle {
+  display: grid;
+  gap: var(--s-2) clamp(1.5rem, 3vw, 2.5rem);
+  padding-block: var(--s-5);
+  border-block-end: var(--hairline) solid var(--line);
+  align-items: baseline;
+  transition: background var(--dur) var(--ease-inout);
+}
+
+@media (min-width: 54rem) {
+  .principle { grid-template-columns: 5.5rem minmax(0, 1fr) minmax(0, 1.15fr) auto; }
+}
+
+.principle:hover { background: color-mix(in srgb, var(--paper-deep) 65%, transparent); }
+
+.principle__n {
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  font-variant-numeric: tabular-nums;
+}
+
+.principle__name { font-family: var(--serif); font-size: var(--t-h3); letter-spacing: -0.014em; }
+.principle__note { max-width: 52ch; color: var(--text-quiet); font-size: var(--t-small); }
+
+.stage-head {
+  display: grid;
+  gap: var(--s-3) clamp(1.5rem, 3vw, 2.5rem);
+  padding-block: var(--s-7) var(--s-5);
+}
+
+@media (min-width: 54rem) { .stage-head { grid-template-columns: 5.5rem minmax(0, 1fr); } }
+
+.stage-head > .label { white-space: nowrap; }
+.stage-head h2 { max-width: 22ch; font-size: var(--t-h3); }
+.stage-head p { max-width: 52ch; margin-block-start: var(--s-3); color: var(--text-quiet); font-size: var(--t-small); }
+
+/* Article chrome ---------------------------------------------------------- */
+
+.article-hero { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3rem); }
+.article-hero .t-h1 { max-width: 18ch; }
+
+.article-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--s-2) var(--s-4);
+  margin-block-start: var(--s-5);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.back-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5em;
+  margin-block-end: var(--s-6);
+  color: var(--text-quiet);
+  font-size: var(--t-small);
+  font-weight: 500;
+}
+
+.back-link span[aria-hidden] { transition: transform var(--dur) var(--ease-out); }
+.back-link:hover { color: var(--text); }
+.back-link:hover span[aria-hidden] { transform: translateX(-3px); }
+
+.article-figure { margin-block: var(--s-7); }
+.article-figure img { width: 100%; border-radius: var(--r-sm); }
+.article-figure figcaption { padding-block-start: var(--s-3); color: var(--text-faint); font-size: var(--t-tiny); }
+
+.pager {
+  display: grid;
+  gap: var(--s-4);
+  padding-block-start: var(--s-6);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+@media (min-width: 40rem) { .pager { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+.pager a { display: grid; gap: var(--s-2); }
+.pager .label { margin: 0; }
+.pager strong { font-family: var(--serif); font-size: var(--t-h4); font-weight: 400; }
+.pager > :last-child:nth-child(2) { text-align: right; }
+
+/* ==========================================================================
+   17  PROSE AND LEGAL
+   ========================================================================== */
+
+.prose {
+  /* The `ch` unit is the width of a zero, which is wider than the average
+     letter: 55ch of Inter renders at roughly 77 characters a line. That is
+     the measure this site reads at, and it is inside the 80-character limit
+     the typography harness enforces. */
+  max-width: 55ch;
+  font-size: 1.075rem;
+  line-height: 1.68;
+}
+
+.prose > * + * { margin-block-start: var(--s-5); }
+
+.prose :is(h2, h3, h4) { margin-block-start: var(--s-8); }
+.prose :is(h2, h3, h4) + * { margin-block-start: var(--s-4); }
+
+.prose h2 { font-size: clamp(1.55rem, 1.25rem + 1.2vw, 2.15rem); }
+.prose h3 { font-size: var(--t-h3); }
+.prose h4 { font-family: var(--sans); font-size: var(--t-h4); font-weight: 600; }
+
+.prose :is(ul, ol) { display: grid; gap: var(--s-3); padding-inline-start: 1.4rem; }
+.prose li { min-width: 0; }
+.prose a { overflow-wrap: anywhere; }
+.prose ul { list-style: disc; }
+.prose ol { list-style: decimal; }
+.prose li::marker { color: var(--text-faint); }
+
+.prose blockquote {
+  padding-inline-start: var(--s-5);
+  border-inline-start: 2px solid var(--line-strong);
+  font-family: var(--serif);
+  font-size: 1.3rem;
+  line-height: 1.4;
+  letter-spacing: -0.012em;
+}
+
+.prose blockquote p + p { margin-block-start: var(--s-4); }
+
+.prose hr { margin-block: var(--s-8); border: 0; border-block-start: var(--hairline) solid var(--line); }
+
+.prose img { border-radius: var(--r-sm); }
+
+.prose :is(code, kbd, samp) {
+  padding: 0.1em 0.35em;
+  background: var(--paper-deep);
+  border-radius: var(--r-xs);
+  font-size: 0.92em;
+}
+
+.prose pre {
+  padding: var(--s-4);
+  overflow-x: auto;
+  background: var(--paper-deep);
+  border-radius: var(--r-sm);
+}
+
+.prose pre code { padding: 0; background: none; }
+
+.prose table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--t-small);
+}
+
+.prose :is(th, td) {
+  padding: var(--s-3) var(--s-3) var(--s-3) 0;
+  border-block-end: var(--hairline) solid var(--line);
+  text-align: left;
+  vertical-align: top;
+}
+
+.prose th { font-weight: 600; }
+
+.table-scroll { overflow-x: auto; }
+
+/* Legal chrome */
+
+.legal-draft-notice {
+  max-width: 62ch;
+  margin-block-end: var(--s-7);
+  padding: var(--s-5);
+  background: var(--paper-deep);
+  border: var(--hairline) solid var(--line-strong);
+  border-radius: var(--r-sm);
+  font-size: var(--t-small);
+}
+
+.legal-draft-notice :is(h2, p:first-child) { font-family: var(--sans); font-size: var(--t-h4); font-weight: 600; }
+.legal-draft-notice > * + * { margin-block-start: var(--s-3); }
+.legal-draft-notice ul { display: grid; gap: var(--s-2); padding-inline-start: 1.2rem; list-style: disc; }
+
+.legal-flag,
+.legal-todo {
+  display: inline-block;
+  padding: 0.1em 0.4em;
+  background: color-mix(in srgb, var(--clay) 12%, transparent);
+  border-radius: var(--r-xs);
+  color: #63381f;                /* 7.4:1 on the tint it sits on */
+  font-size: 0.94em;
+}
+
+.legal-version {
+  max-width: 54ch;
+  margin-block-start: var(--s-7);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.legal-toc {
+  margin-block-end: var(--s-7);
+  padding-block-end: var(--s-6);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+.legal-toc ol {
+  display: grid;
+  gap: var(--s-2);
+  margin-block-start: var(--s-4);
+  counter-reset: clause;
+}
+
+@media (min-width: 48rem) { .legal-toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-2) var(--s-6); } }
+
+.legal-toc a { color: var(--text-quiet); font-size: var(--t-small); }
+.legal-toc a:hover { color: var(--text); }
+
+/* ==========================================================================
+   18  PURCHASE JOURNEY
+   ========================================================================== */
+
+.buy {
+  display: grid;
+  gap: var(--s-4);
+  padding: clamp(1.5rem, 3.5vw, 2.25rem);
+  background: var(--paper);
+  border: var(--hairline) solid var(--line-strong);
+  border-radius: var(--r);
+}
+
+.on-ink .buy { background: transparent; border-color: var(--line-on-ink); }
+
+.buy__price {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: var(--s-2) var(--s-4);
+}
+
+.buy__price b {
+  font-family: var(--serif);
+  font-size: clamp(1.8rem, 1.4rem + 1.5vw, 2.4rem);
+  font-weight: 400;
+  letter-spacing: -0.025em;
+  font-variant-numeric: lining-nums;
+}
+
+.buy__terms { max-width: 52ch; color: var(--text-quiet); font-size: var(--t-tiny); }
+.on-ink .buy__terms { color: var(--on-ink-quiet); }
+
+.buy__actions { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); align-items: center; }
+
+.scope-nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--s-2) var(--s-5);
+  padding-block: var(--s-4);
+  border-block: var(--hairline) solid var(--line);
+}
+
+.scope-nav a { color: var(--text-quiet); font-size: var(--t-small); }
+.scope-nav a:hover { color: var(--text); }
+
+.scope-block { padding-block: var(--band-sm); border-block-start: var(--hairline) solid var(--line); }
+.scope-block:first-of-type { border-block-start: 0; }
+
+.step-list { counter-reset: step; }
+
+.step-list li {
+  position: relative;
+  display: grid;
+  gap: var(--s-1) var(--s-5);
+  padding: var(--s-4) 0 var(--s-4) 3rem;
+  border-block-start: var(--hairline) solid var(--line-soft);
+  font-size: var(--t-small);
+}
+
+@media (min-width: 48rem) { .step-list li { grid-template-columns: 14rem minmax(0, 1fr); align-items: baseline; } }
+
+.step-list li::before {
+  counter-increment: step;
+  content: counter(step, decimal-leading-zero);
+  position: absolute;
+  inset-inline-start: 0;
+  inset-block-start: var(--s-4);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  font-variant-numeric: tabular-nums;
+}
+
+.step-list b { font-weight: 600; }
+.step-list span { color: var(--text-quiet); }
+
+.notice {
+  padding: var(--s-5);
+  background: var(--paper-deep);
+  border-inline-start: 2px solid var(--line-strong);
+  border-radius: 0 var(--r-sm) var(--r-sm) 0;
+  font-size: var(--t-small);
+}
+
+.notice { max-width: 62ch; }
+.notice > * + * { margin-block-start: var(--s-3); }
+.notice strong { font-weight: 600; }
+
+/* The assembled-answers panel and the read-only field inside it. */
+.output-area {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--s-3);
+  margin-block-start: var(--s-7);
+  padding: clamp(1.25rem, 3vw, 2rem);
+  background: var(--paper-deep);
+  border-radius: var(--r);
+}
+
+.output-area h2 { font-size: var(--t-h3); }
+
+.output-area textarea {
+  display: block;
+  width: 100%;
+  max-width: 100%;
+  min-width: 0;
+  min-height: 16rem;
+  padding: var(--s-4);
+  background: var(--paper);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--r-sm);
+  font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
+  font-size: 0.82rem;
+  line-height: 1.6;
+  resize: vertical;
+}
+
+/* ==========================================================================
+   19  SMALL PAGES
+   ========================================================================== */
+
+.center-page {
+  display: grid;
+  place-items: center;
+  min-height: 62vh;
+  padding-block: var(--band);
+  text-align: center;
+}
+
+.center-page .lead { margin-inline: auto; }
+
+.links-list { display: grid; gap: var(--s-3); }
+
+.links-list a {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--s-4);
+  padding: var(--s-5);
+  background: var(--paper);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--r);
+  font-size: var(--t-small);
+  font-weight: 600;
+  transition: border-color var(--dur) var(--ease-inout), transform var(--dur) var(--ease-out);
+}
+
+.links-list a:hover { border-color: var(--ink); }
+
+
+/* ==========================================================================
+   20  PRACTICE CLARITY GUIDES
+   The nine principles carry their own in-content components, authored in the
+   guide markdown. They keep their existing class names — rewriting a hundred
+   callouts to rename them would have been change without improvement — and
+   are restated here on the new tokens.
+   ========================================================================== */
+
+/* Article body: a reading measure with a wider track either side, so the
+   chapter opener, figures, diagrams and the reflection grid can step outside
+   the text column without leaving the container. */
+.acw-guide-content,
+.acw-post-content {
+  display: grid;
+  max-width: none;
+  grid-template-columns:
+    [wide-start] minmax(0, 1fr)
+    [text-start] min(100%, 55ch) [text-end]
+    minmax(0, 1fr) [wide-end];
+}
+
+.acw-guide-content > *,
+.acw-post-content > * { grid-column: text; }
+
+.acw-guide-content > :where(
+  .acw-guide-chapter-intro, .acw-guide-figure, .acw-guide-diagram,
+  .acw-reflection-grid, .acw-principle-navigation, .acw-guide-learning-summary,
+  .acw-practice-farewell),
+.acw-post-content > :where(.acw-guide-figure, .acw-guide-diagram) {
+  grid-column: wide;
+}
+
+.acw-guide-breadcrumb {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.55rem;
+  margin-block: var(--s-4) var(--s-5);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.acw-guide-breadcrumb a {
+  display: inline-block;
+  padding-block: 0.35rem;
+  min-height: 26px;
+}
+
+.acw-guide-breadcrumb a:hover { color: var(--text); }
+.acw-guide-breadcrumb strong { color: var(--text-quiet); font-weight: 500; }
+
+.acw-guide-chapter-intro { padding-block: var(--s-6) var(--s-6); }
+
+.acw-guide-chapter-grid {
+  display: grid;
+  gap: clamp(2rem, 5vw, 3.5rem);
+  align-items: start;
+}
+
+@media (min-width: 62rem) {
+  .acw-guide-chapter-grid { grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.85fr); }
+}
+
+.acw-guide-chapter-grid > * { min-width: 0; }
+
+.acw-guide-series,
+.acw-guide-kicker,
+.acw-section-label {
+  display: block;
+  margin-block-end: var(--s-3);
+  color: var(--text-faint);
+  font-size: var(--t-label);
+  font-weight: 600;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+
+.acw-guide-chapter-intro h1 { max-width: 16ch; margin-block: var(--s-4) var(--s-5); }
+
+.acw-guide-deck {
+  max-width: 34ch;
+  font-family: var(--serif);
+  font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.65rem);
+  line-height: 1.3;
+  letter-spacing: -0.016em;
+  color: var(--text-quiet);
+}
+
+.acw-guide-meta,
+.acw-guide-reflection-time {
+  margin-block-start: var(--s-5);
+  padding-block-start: var(--s-4);
+  border-block-start: var(--hairline) solid var(--line);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.acw-guide-intro-panel,
+.acw-guide-learning-summary,
+.acw-guide-anchor-panel,
+.acw-guide-progress-card {
+  margin-block: var(--s-7);
+  padding: clamp(1.5rem, 3.5vw, 2.25rem);
+  background: var(--paper-deep);
+  border-radius: var(--r);
+  font-size: var(--t-small);
+}
+
+.acw-guide-intro-panel > * + *,
+.acw-guide-learning-summary > * + *,
+.acw-guide-anchor-panel > * + * { margin-block-start: var(--s-3); }
+
+.acw-guide-intro-lead {
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  line-height: 1.4;
+  letter-spacing: -0.014em;
+  color: var(--text);
+}
+
+.acw-guide-learning-summary ul,
+.acw-guide-anchor-panel ul { display: grid; gap: var(--s-2); padding-inline-start: 1.2rem; list-style: disc; }
+/* The panel is a list of section links, so each is a target in its own
+   right rather than an inline word: it gets its own line and a 24px box. */
+.acw-guide-anchor-panel a {
+  display: block;
+  padding-block: 0.4rem;
+  min-height: 26px;
+  color: var(--text-quiet);
+  border-block-end: var(--hairline) solid var(--line);
+}
+
+.acw-guide-anchor-panel a:last-child { border-block-end: 0; }
+.acw-guide-anchor-panel a:hover { color: var(--text); }
+
+.acw-guide-progress-card ol { display: grid; gap: var(--s-2); counter-reset: pc; }
+
+.acw-guide-progress-card { align-self: start; }
+
+.acw-guide-progress-card li {
+  counter-increment: pc;
+  display: grid;
+  grid-template-columns: 1.9rem minmax(0, 1fr);
+  gap: var(--s-2);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+  line-height: 1.35;
+}
+
+.acw-guide-progress-card li::before {
+  content: counter(pc, decimal-leading-zero);
+  font-size: var(--t-tiny);
+  font-variant-numeric: tabular-nums;
+}
+
+.acw-guide-progress-card li.is-complete { color: var(--text-quiet); }
+.acw-guide-progress-card li.is-current { color: var(--text); font-weight: 600; }
+
+/* Callouts. One frame, three roles distinguished by a marker rather than a
+   colour: a framework states, an exercise asks. */
+
+.acw-callout {
+  margin-block: var(--s-7);
+  padding: clamp(1.5rem, 3.5vw, 2rem);
+  background: var(--paper-deep);
+  border-inline-start: 2px solid var(--line-strong);
+  border-radius: 0 var(--r-sm) var(--r-sm) 0;
+  font-size: var(--t-small);
+}
+
+.acw-callout > * + * { margin-block-start: var(--s-3); }
+.acw-callout strong { display: block; font-weight: 600; }
+.acw-callout strong:first-child { color: var(--text); }
+
+.acw-framework { border-inline-start-color: var(--ink); }
+.acw-exercise { border-inline-start-color: var(--clay); background: transparent; border: var(--hairline) solid var(--line); border-inline-start: 2px solid var(--clay); }
+.acw-exercise em { color: var(--text); }
+
+.acw-framework-flow {
+  display: grid;
+  justify-items: start;
+  gap: var(--s-2);
+  margin-block: var(--s-5);
+  padding-inline-start: var(--s-4);
+  border-inline-start: var(--hairline) solid var(--line-strong);
+  font-family: var(--serif);
+  font-size: 1.2rem;
+  line-height: 1.25;
+  letter-spacing: -0.014em;
+}
+
+.acw-framework-flow p { margin: 0; }
+
+.acw-reflection-grid { display: grid; gap: var(--s-4); margin-block: var(--s-7); }
+@media (min-width: 48rem) { .acw-reflection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+.acw-reflection-grid .acw-callout { margin-block: 0; height: 100%; }
+
+.acw-pullquote {
+  margin-block: var(--s-8);
+  padding-inline-start: var(--s-5);
+  border-inline-start: 2px solid var(--clay);
+  font-family: var(--serif);
+  font-size: clamp(1.45rem, 1.2rem + 1.1vw, 2rem);
+  line-height: 1.24;
+  letter-spacing: -0.02em;
+  text-wrap: balance;
+}
+
+.acw-pullquote p { margin: 0; }
+
+.acw-guide-emphasis {
+  font-family: var(--serif);
+  font-size: 1.3rem;
+  line-height: 1.35;
+  letter-spacing: -0.016em;
+}
+
+.acw-guide-emphasis strong { font-weight: 400; }
+
+.acw-guide-figure,
+.acw-guide-diagram { margin-block: var(--s-8); }
+
+.acw-guide-figure img,
+.acw-guide-diagram img { width: 100%; border-radius: var(--r-sm); }
+
+.acw-guide-figure figcaption,
+.acw-guide-diagram figcaption {
+  padding-block-start: var(--s-3);
+  color: var(--text-faint);
+  font-size: var(--t-tiny);
+}
+
+.acw-guide-diagram { padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--paper-deep); border-radius: var(--r); }
+
+.acw-principle-navigation {
+  display: grid;
+  gap: var(--s-5);
+  padding-block-start: var(--s-6);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+@media (min-width: 48rem) { .acw-principle-navigation { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+.acw-principle-navigation-card { display: grid; gap: var(--s-2); align-content: start; }
+.acw-principle-navigation-card h3 { font-size: var(--t-h4); font-family: var(--serif); font-weight: 400; }
+.acw-principle-navigation-card p { max-width: 52ch; color: var(--text-quiet); font-size: var(--t-small); }
+.acw-principle-navigation-card a { font-size: var(--t-small); font-weight: 600; }
+.acw-principle-navigation-card a:hover { color: var(--text); }
+.acw-principle-navigation-current { color: var(--text-faint); font-size: var(--t-tiny); }
+
+.acw-principle-remember,
+.acw-guide-next-card {
+  margin-block-start: var(--s-7);
+  padding: clamp(1.5rem, 3.5vw, 2rem);
+  border: var(--hairline) solid var(--line);
+  border-radius: var(--r);
+  font-size: var(--t-small);
+}
+
+.acw-principle-remember > * + *,
+.acw-guide-next-card > * + * { margin-block-start: var(--s-3); }
+
+.acw-btn,
+.acw-btn-primary {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.6em;
+  min-height: 48px;
+  padding: 0.92rem 1.6rem;
+  background: var(--ink);
+  color: var(--on-ink);
+  font-size: var(--t-small);
+  font-weight: 600;
+  border-radius: 999px;
+  transition: background var(--dur) var(--ease-inout);
+}
+
+.acw-btn:hover { background: var(--ink-deep); }
+.on-ink .acw-btn { background: var(--on-ink); color: var(--ink); }
+
+.acw-link-tertiary,
+.acw-library-text-link {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 0.5em;
+  font-size: var(--t-small);
+  font-weight: 600;
+  background-image: linear-gradient(currentColor, currentColor);
+  background-repeat: no-repeat;
+  background-position: 0 100%;
+  background-size: 100% 1px;
+  transition: background-size var(--dur-slow) var(--ease-out);
+}
+
+.acw-link-tertiary:hover,
+.acw-library-text-link:hover { background-size: 100% 2px; }
+
+.acw-cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-5); margin-block-start: var(--s-5); }
+
+.acw-practice-farewell { padding-block: var(--band-sm); }
+.acw-practice-farewell-lead { font-size: var(--t-lead); color: var(--text-quiet); }
+.acw-practice-farewell-question { font-family: var(--serif); font-size: var(--t-h3); }
+.acw-practice-farewell-signoff { color: var(--text-faint); font-size: var(--t-small); }
+
+/* --------------------------------------------------------------------------
+   Article rhythm.
+
+   These come last in the section deliberately: they replace the per-component
+   margins above with grid rows. Margins do not collapse between grid items,
+   so leaving both would double every gap — and markdown wrapped around raw
+   HTML leaves empty paragraphs that would otherwise become rows of their own.
+   -------------------------------------------------------------------------- */
+
+.acw-guide-content,
+.acw-post-content { row-gap: var(--s-6); }
+
+.acw-guide-content > *,
+.acw-post-content > * { margin-block: 0; }
+
+.acw-guide-content > :is(p, section, div, figure, nav, aside):empty,
+.acw-post-content > :is(p, section, div, figure, nav, aside):empty { display: none; }
+
+.acw-guide-content > :is(h2, h3, h4),
+.acw-post-content > :is(h2, h3, h4) { margin-block-start: var(--s-5); }
+
+.acw-guide-content > hr,
+.acw-post-content > hr { margin-block: var(--s-2); }
+
+.acw-guide-content > :is(.acw-callout, .acw-pullquote, .acw-guide-figure, .acw-guide-diagram, .acw-reflection-grid),
+.acw-post-content > :is(.acw-callout, .acw-pullquote, .acw-guide-figure, .acw-guide-diagram) { margin-block: var(--s-3); }
+
+/* Print ------------------------------------------------------------------- */
+
+@media print {
+  .site-header, .site-footer, .skip-link, .fan, .plate { display: none; }
+  body { background: #fff; color: #000; }
+  .band { padding-block: 1rem; }
+}
+
+/* Scroll-driven entrances hold their start state until their element enters
+   the scroll range. Print has no scroll timeline, so they are turned off
+   here rather than left at opacity 0 on paper. */
+@media print {
+  .rise,
+  .rise-group > *,
+  .step-in > *,
+  .fan__item,
+  .enter { animation: none; opacity: 1; transform: none; }
+}
+
+.btn.is-unavailable {
+  --btn-bg: transparent;
+  --btn-fg: var(--text-quiet);
+  border-style: dashed;
+  border-color: var(--line-strong);
+  cursor: not-allowed;
+}
+
+.on-ink .btn.is-unavailable { --btn-fg: var(--on-ink-quiet); border-color: var(--line-on-ink); }
+.buy-unavailable strong { display: block; margin-block-end: var(--s-2); font-weight: 600; }
+.on-paper .buy-unavailable strong,
+.on-paper-deep .buy-unavailable strong { color: var(--text); }
+.on-ink .buy-unavailable strong { color: var(--on-ink); }
+
+/* Legal and statement pages keep their existing structure; only the hero
+   wrapper needs a rule of its own. */
+.acw-page-hero { padding-block-end: var(--s-6); }
+.acw-page-hero h1 { max-width: 18ch; margin-block: var(--s-4) 0; }
+.acw-page-hero .lead { margin-block-start: var(--s-5); max-width: 48ch; }
+
+
+/* ==========================================================================
+   21  UTILITIES
+   A deliberately short list. These exist so page templates can set a measure
+   or a rhythm without inline styles — not as a general utility framework.
+   ========================================================================== */
+
+.measure-3xs { max-width: 13ch; }
+.measure-2xs { max-width: 15ch; }
+.measure-xs  { max-width: 17ch; }
+.measure-sm  { max-width: 20ch; }
+.measure-md  { max-width: 23ch; }
+.measure-lg  { max-width: 34ch; }
+.measure-xl  { max-width: 44ch; }
+.measure-2xl { max-width: 56ch; }
+
+.mt-3 { margin-block-start: var(--s-3); }
+.mt-4 { margin-block-start: var(--s-4); }
+.mt-5 { margin-block-start: var(--s-5); }
+.mt-6 { margin-block-start: var(--s-6); }
+.mt-7 { margin-block-start: var(--s-7); }
+.mt-8 { margin-block-start: var(--s-8); }
+.mb-5 { margin-block-end: var(--s-5); }
+.mb-6 { margin-block-end: var(--s-6); }
+.mb-7 { margin-block-end: var(--s-7); }
+.mb-8 { margin-block-end: var(--s-8); }
+.m-0  { margin: 0; }
+
+.align-end { align-items: end; }
+.align-center { align-items: center; }
+.gap-6 { gap: var(--s-6); }
+
+/* A hairline above a block, with the space that belongs to it. */
+.divider-top {
+  padding-block-start: var(--s-5);
+  border-block-start: var(--hairline) solid var(--line);
+}
+
+.center-text { text-align: center; justify-items: center; }
